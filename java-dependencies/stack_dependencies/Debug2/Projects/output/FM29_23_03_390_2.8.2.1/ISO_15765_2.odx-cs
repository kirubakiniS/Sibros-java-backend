        <COMPARAMS>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_Ar"
                OID="26559478-e39f-46f0-b31c-e974dbca2ba7" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_Ar</SHORT-NAME>
                <LONG-NAME TI="TI_1955443643">CP_Ar</LONG-NAME>
                <DESC TI="TI_1626097132">
                    <p>Time for transmission of the CAN frame (any N_PDU) on the receiver side</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_As"
                OID="0425f20d-2222-49a2-bdbb-e901f112d76c" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_As</SHORT-NAME>
                <LONG-NAME TI="TI_1707136049">CP_As</LONG-NAME>
                <DESC TI="TI_3194199">
                    <p>Time for transmission of the CAN frame (any N_PDU) on the sender side</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_BlockSize"
                OID="4aba5de9-2c9c-465f-b654-6e2f62159e1a" PARAM-CLASS="COM">
                <SHORT-NAME>CP_BlockSize</SHORT-NAME>
                <LONG-NAME TI="TI_323538337">CP_BlockSize</LONG-NAME>
                <DESC TI="TI_1053023382">
                    <p>This sets the block size that the interface should report to the vehicle for receiving segmented transfers in a Transmit Flow Control Message.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT8"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_BlockSizeOverride"
                OID="14b43e01-6631-42de-b324-3089cf591b03" PARAM-CLASS="COM">
                <SHORT-NAME>CP_BlockSizeOverride</SHORT-NAME>
                <LONG-NAME TI="TI_1760904910">CP_BlockSizeOverride</LONG-NAME>
                <DESC TI="TI_731839319">
                    <p>This sets the block size that the interface should use to send segmented messages to the vehicle.</p>
                    <p>The flow control value reported by the vehicle should be ignored.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>65535</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT16_BlockSizeOverride"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_Br"
                OID="5068925c-1e1f-43b9-bc7f-ad99e2eb2c21" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_Br</SHORT-NAME>
                <LONG-NAME TI="TI_184244264">CP_Br</LONG-NAME>
                <DESC TI="TI_722321707">
                    <p>Time until transmission of the next FlowControl</p>
                    <p>This is equivalent to Th in J1939-21.</p>
                    <p>For ISO 15765-2 and ISO 15765-4, this value is a performance requirement ComParam and should not be used as a timeout value by the tester.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>10000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_Bs"
                OID="8c9457bd-15a0-40c2-ab04-4061f6b47ed8" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_Bs</SHORT-NAME>
                <LONG-NAME TI="TI_1965755689">CP_Bs</LONG-NAME>
                <DESC TI="TI_1838424279">
                    <p>Timeout until reception of the next FlowControl</p>
                    <p>This is equivalent to T4 in J1939-21.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_CanDataSizeOffset"
                OID="c12ef02d-3b67-47c7-8caf-7040f76eaf95" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanDataSizeOffset</SHORT-NAME>
                <LONG-NAME TI="TI_1923425309">CP_CanDataSizeOffset</LONG-NAME>
                <DESC TI="TI_228902002">
                    <p>Offset subtracted from the total number of expected bytes received/transmitted in a first frame message</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT4_0_8"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanFillerByte"
                OID="eb461b6a-f488-45f3-898c-ffcf4bdb28c8" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFillerByte</SHORT-NAME>
                <LONG-NAME TI="TI_1525379633">CP_CanFillerByte</LONG-NAME>
                <DESC TI="TI_1701605304">
                    <p>Padding data byte to be used to pad all USDT type transmits frames (SF, FC, and last CF)</p>
                    <p>NOTE: The padding data byte value is typically 0x00, 0x55, or 0xAA.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>85</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT8_HEX"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanFillerByteHandling"
                OID="85c3ee4a-f340-47bd-a19f-11201e025806" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFillerByteHandling</SHORT-NAME>
                <LONG-NAME TI="TI_801188055">CP_CanFillerByteHandling</LONG-NAME>
                <DESC TI="TI_266830208">
                    <p>Enable Padding, forcing the DLC of a CAN frame to always be 8</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Enabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_CanFirstConsecutiveFrameValue"
                OID="a5759cda-a728-47ba-906e-ff44d5922c82" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFirstConsecutiveFrameValue</SHORT-NAME>
                <LONG-NAME TI="TI_1293468407">CP_CanFirstConsecutiveFrameValue</LONG-NAME>
                <DESC TI="TI_571407485">
                    <p>First consecutive frame number to be transmitted/received on a multi-segment transfer</p>
                    <p>Used to override the normal first consecutive frame value of 1.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT4_HEX"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanFuncReqExtAddr"
                OID="d8107d8b-a880-4b92-8ffa-c279f1f67835" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFuncReqExtAddr</SHORT-NAME>
                <LONG-NAME TI="TI_196269023">CP_CanFuncReqExtAddr</LONG-NAME>
                <DESC TI="TI_1559098262">
                    <p>Address extension for enhanced diagnostics</p>
                    <p>The first byte of the requested CAN frame data contains the N_AE/N_TA byte followed by the correct number of PCI bytes.</p>
                    <p>This ComParam is used for all transmitted CAN Frames that have the “Can Address Extension” bit set in the CanIdFormat.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT8_HEX"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanFuncReqFormat"
                OID="622510d7-3f46-49c2-b7f0-eccf89c08756" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFuncReqFormat</SHORT-NAME>
                <LONG-NAME TI="TI_1660721500">CP_CanFuncReqFormat</LONG-NAME>
                <DESC TI="TI_1433783595">
                    <p>CAN Format used for a functional address transmit</p>
                    <p>See TEXTTABLE_UINT6_CanReqFormat</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>normal segmented 11-bit transmit with FC</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT6_CanReqFormat"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanFuncReqId"
                OID="45a1b81f-4d4f-4947-aae3-da2d65b71b3e" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanFuncReqId</SHORT-NAME>
                <LONG-NAME TI="TI_533003377">CP_CanFuncReqId</LONG-NAME>
                <DESC TI="TI_1822570092">
                    <p>CAN ID used for a functional address transmit</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>2015</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT29_HEX"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_CanMaxNumWaitFrames"
                OID="1a2dfec6-9683-4877-863d-c705f1b8f67a" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CanMaxNumWaitFrames</SHORT-NAME>
                <LONG-NAME TI="TI_496628443">CP_CanMaxNumWaitFrames</LONG-NAME>
                <DESC TI="TI_1155821704">
                    <p>The maximum number of WAIT flow control frames allowed during a multi-segment transfer</p>
                    <p>For SAE J1939, this is the maximum number of allowed CTS frames.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>255</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT11_0_1027"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_Cr"
                OID="deb339bf-ab6e-4493-a7e0-cf3a47c65e53" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_Cr</SHORT-NAME>
                <LONG-NAME TI="TI_2653042">CP_Cr</LONG-NAME>
                <DESC TI="TI_1930685880">
                    <p>Timeout for reception of the next ConsecutiveFrame</p>
                    <p>For SAE J1939-21, this is equivalent to T1.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_Cs"
                OID="b33e706b-16d6-4cc9-b18d-77527f956166" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_Cs</SHORT-NAME>
                <LONG-NAME TI="TI_1636712200">CP_Cs</LONG-NAME>
                <DESC TI="TI_1390894282">
                    <p>Time until transmission of the next Consecutive Frame</p>
                    <p>(This is used if FC is not enabled or if the STmin value in the FC=0 and STminOverride=0xFFFF.) See ISO 15765-2.</p>
                    <p>For ISO 15765-2 and ISO 15765-4, this is a performance requirement ComParam and should not be used as a timeout value by the tester.</p>
                    <p>For SAE J1939, this is equivalent to the time between sending packets in a multi-packet broadcast and a multi-packet destination-specific message. From text in SAE J1939-21:2006, 5.12.3.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>10000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_20000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_RepeatReqCountTrans"
                OID="96e346bb-6a4e-4cb2-b9ee-54daceb6cce8" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RepeatReqCountTrans</SHORT-NAME>
                <LONG-NAME TI="TI_1832280487">CP_RepeatReqCountTrans</LONG-NAME>
                <DESC TI="TI_710701749">
                    <p>This ComParam contains a counter to enable a re-transmission of the last request when either a transmit, a receive error, or transport layer timeout is detected.</p>
                    <p>This applies to the transport layer only.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT8"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_RequestAddrMode"
                OID="56167821-763f-44e9-9a60-61c757af5856" PARAM-CLASS="COM">
                <SHORT-NAME>CP_RequestAddrMode</SHORT-NAME>
                <LONG-NAME TI="TI_35453009">CP_RequestAddrMode</LONG-NAME>
                <DESC TI="TI_687649612">
                    <p>Addressing Mode to be used for the Com Primitive</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Physical</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT2_1_2_RequestAddrMode"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_SendRemoteFrame"
                OID="0c391da3-8e62-446f-8757-3e95767762b0" PARAM-CLASS="COM">
                <SHORT-NAME>CP_SendRemoteFrame</SHORT-NAME>
                <LONG-NAME TI="TI_1137610535">CP_SendRemoteFrame</LONG-NAME>
                <DESC TI="TI_937692445">
                    <p>This ComParam is used for CAN remote frame handling.</p>
                    <p>(No data bytes are transmitted. Just the CAN ID. The first byte of the PDU Data shall contain the Data Length Code.)</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>No remote frame</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_SendRemoteFrame"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_StMin"
                OID="4c905ab8-5846-4671-a307-4a81dd25e81d" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_StMin</SHORT-NAME>
                <LONG-NAME TI="TI_1524256610">CP_StMin</LONG-NAME>
                <DESC TI="TI_1572893959">
                    <p>This sets the separation time the interface should report to the vehicle for receiving segmented transfers in a Transmit Flow Control Message.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="SCALE_LINEAR_UINT8_INT32_MicroSecond_StMin"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_StMinOverride"
                OID="0bf0aff2-1898-4b6a-9664-4265875f3477" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_StMinOverride</SHORT-NAME>
                <LONG-NAME TI="TI_855366255">CP_StMinOverride</LONG-NAME>
                <DESC TI="TI_636457347">
                    <p>This sets the separation time the interface should use to transmit segmented messages to the vehicle.</p>
                    <p>The flow control value reported by the vehicle should be ignored.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>4294967295</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond_StMinOverride"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_2.CP_CANFDTxMaxDataLength"
                OID="9920eeb9-e625-47fc-aa47-0094b2888ea9" PARAM-CLASS="COM">
                <SHORT-NAME>CP_CANFDTxMaxDataLength</SHORT-NAME>
                <LONG-NAME TI="TI_892688183">CP_CANFDTxMaxDataLength</LONG-NAME>
                <DESC TI="TI_433017424">
                    <p>Value of ISO15765-2 TX_DL parameter. Also used <br/>to identify whether Classic CAN or CANFD to be used for the <br/>transmission. <br/>TX_DL = 8 : Classic CAN mode or CANFD mode <br/>TX_DL &gt; 8 : CANFD mode <br/>The value is stored in the D‐PDU API, but only used if a proper<br/>value for the ComParam CP_CANFDBaudrate is set (can occur <br/>after setting CP_CANFDTxMaxDataLength). Otherwise, TX_DL <br/>= 8 will be used. <br/>NOTE 5    If filler bytes are needed in case of TX_DL &gt; 8, the <br/>value defined in CP_CanFillerByte shall be used, regardless of <br/>the value in CP_CanFillerByteHandling.</p>
                    <p/>
                    <p>Type: PDU_PT_UNUM32 <br/>Value [0;8;9;10;11;12;13;14;15]  <br/>0:   TX_DL = 8,   Classic CAN <br/>8:   TX_DL = 8,   CANFD <br/>9:   TX_DL = 12, CANFD <br/>10: TX_DL = 16, CANFD <br/>11: TX_DL = 20, CANFD <br/>12: TX_DL = 24, CANFD <br/>13: TX_DL = 32, CANFD <br/>14: TX_DL = 48, CANFD <br/>15: TX_DL = 64, CANFD</p>
                    <p/>
                    <p>Default: 0</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>TX_DL=8 Classic CAN</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_MaxDataLength"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_EscapeSequenceHandling"
                OID="deac2faa-37b7-4932-80cd-d402b6f9cade" PARAM-CLASS="COM">
                <SHORT-NAME>CP_EscapeSequenceHandling</SHORT-NAME>
                <LONG-NAME TI="TI_1791626600">CP_EscapeSequenceHandling</LONG-NAME>
                <DESC TI="TI_383590294">
                    <p>This ComParam is used to enable/disable the ISO15765-2 multi-frame escape sequence on classical CAN or CAN FD.</p>
                    <p>Type: PDU_PT_UNUM32 Range [0;0xFFFFFFFF] 0: don't use escape sequence 1: use escape sequence according to ISO15765-2 2: 0xFFFFFFFF: ISO reserved.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT4_HEX"/>
            </COMPARAM>
        </COMPARAMS>
        <COMPLEX-COMPARAMS>
            <COMPLEX-COMPARAM ALLOW-MULTIPLE-VALUES="true"
                CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_15765_2.CP_UniqueRespIdTable"
                OID="91f67343-239e-4173-924d-17cd8a787bae" PARAM-CLASS="UNIQUE_ID">
                <SHORT-NAME>CP_UniqueRespIdTable</SHORT-NAME>
                <LONG-NAME TI="TI_1699336413">CP_UniqueRespIdTable</LONG-NAME>
                <DESC TI="TI_1219461553">
                    <p>The purpose of this communication parameter is to provide a table that allows the D-server to map the ECU responses to functional requests to their physical source ECUs.</p>
                </DESC>
                <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                    ID="ISO_15765_2.CP_CanPhysReqExtAddr"
                    OID="c6fb2d66-570b-4aec-98ec-7d10c086353b" PARAM-CLASS="UNIQUE_ID">
                    <SHORT-NAME>CP_CanPhysReqExtAddr</SHORT-NAME>
                    <LONG-NAME TI="TI_330643432">CP_CanPhysReqExtAddr</LONG-NAME>
                    <DESC TI="TI_1696466000">
                        <p>Address extension for enhanced diagnostics</p>
                        <p>The first byte of the requested CAN frame data contains the N_AE/N_TA byte followed by the correct number of PCI bytes.</p>
                        <p>This ComParam is used for all transmitted CAN Frames that have the “Can Address Extension” bit set in the CanIdFormat.</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT8_HEX"/>
                </COMPARAM>
                <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                    ID="ISO_15765_2.CP_CanPhysReqFormat"
                    OID="35583efe-d5b5-46f4-bd53-929cbf060bd9" PARAM-CLASS="UNIQUE_ID">
                    <SHORT-NAME>CP_CanPhysReqFormat</SHORT-NAME>
                    <LONG-NAME TI="TI_1691814364">CP_CanPhysReqFormat</LONG-NAME>
                    <DESC TI="TI_1071918641">
                        <p>CAN Format used for a physical address transmit</p>
                        <p>See TEXTTABLE_UINT6_CanReqFormat</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>normal segmented 29-bit transmit with FC and padding enabled</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT6_CanReqFormat"/>
                </COMPARAM>
                <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                    ID="ISO_15765_2.CP_CanPhysReqId"
                    OID="ebfc08b4-ac8e-404c-8936-0fd667525198" PARAM-CLASS="UNIQUE_ID">
                    <SHORT-NAME>CP_CanPhysReqId</SHORT-NAME>
                    <LONG-NAME TI="TI_88897776">CP_CanPhysReqId</LONG-NAME>
                    <DESC TI="TI_280738822">
                        <p>CAN ID used for a physical address transmit</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>215676153</PHYSICAL-DEFAULT-VALUE>
