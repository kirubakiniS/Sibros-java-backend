        <ECU-SHARED-DATAS>
            <ECU-SHARED-DATA ID="ES_UDSFlash" OID="5db5175d-f110-44c5-87dc-3355d3b7a7c1">
                <SHORT-NAME>ES_UDSFlash</SHORT-NAME>
                <LONG-NAME TI="TI_1998541133">ES UDS Flash</LONG-NAME>
                <DESC TI="TI_1964161588">
                    <p>      This ODX 2.2.0 Data is downward compatible with ODX 2.0.1,    </p>
                    <p>      simply change MODEL-VERSION as required    </p>
                </DESC>
                <ADMIN-DATA>
                    <DOC-REVISIONS>
                        <DOC-REVISION>
                            <TEAM-MEMBER-REF ID-REF="ES_UDSFlash.CO_DSADatenUndSysteGmbH.TM_Syste.TEAM-MEMBER"/>
                            <REVISION-LABEL>02.00.00</REVISION-LABEL>
                            <STATE>NEW</STATE>
                            <DATE>2017-06-28T12:47:14</DATE>
                            <TOOL>DatabaseDesigner 1.06.010</TOOL>
                            <MODIFICATIONS>
                                <MODIFICATION>
                                    <CHANGE>ported ASCS ES_UDSFLASH.odx-d to common ES_UDSFlash.odx-d downward compatible with ODX 2.0.1</CHANGE>
                                    <REASON>ASCS ES_UDSFLASH.odx-d was not ODX 2.0.1 compliant</REASON>
                                </MODIFICATION>
                                <MODIFICATION>
                                    <CHANGE>added empty {AUDIENCE/}s in services and jobs</CHANGE>
                                    <REASON>ODX 2.0.1 compliance (schema (bug?) minOccurs=1)</REASON>
                                </MODIFICATION>
                                <MODIFICATION>
                                    <CHANGE>removed IMPORT-REFS (fortunately not required)</CHANGE>
                                    <REASON>ODX 2.0.1 compliance (IMPORT-REFS not available)</REASON>
                                </MODIFICATION>
                            </MODIFICATIONS>
                        </DOC-REVISION>
                        <DOC-REVISION>
                            <TEAM-MEMBER-REF ID-REF="ES_UDSFlash.CO_DSADatenUndSysteGmbH.TM_Syste.TEAM-MEMBER"/>
