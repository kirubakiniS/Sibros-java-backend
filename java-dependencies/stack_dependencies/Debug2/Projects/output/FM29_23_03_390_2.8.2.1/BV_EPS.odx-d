                                            <SD SI="Monitor_Enable_Conditions" TI="TI_380212341"> - Local voltage is within normal range (9-16V) 
 - PwrMod == IGN ON
 - BUS physical status</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_426872011">failure to authenticate at any time</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1229625683">The component shall set the DTC If  any of the below listed conditions occurs:
- Reset counter not updated continuously for 3 second
- uncontrolled jump of more than 10 counts w.r.to previous received sync message.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1273924928">The component shall clear the DTC if Reset counter is getting updated properly every one second at least once.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_298787442">Normal Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1428537002">Reset counter error</SD>
                                            <SD SI="Possible_Impact" TI="TI_298787442">Normal Assist</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_EPS.BV.BV_EPS.DOP.DD_DTCList.DTC.DTC_0xD31486">
                                    <SHORT-NAME>DTC_0xD31486</SHORT-NAME>
                                    <TROUBLE-CODE>13833350</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U131486</DISPLAY-TROUBLE-CODE>
