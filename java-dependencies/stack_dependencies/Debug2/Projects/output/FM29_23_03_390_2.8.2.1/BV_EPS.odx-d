                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_2084601305">1000</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_721705349">TBOX_0x5C8 message absent</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1212431863">TBOX_0x5C8 message received</SD>
                                            <SD SI="Limp_home_Action" TI="TI_298787442">Normal Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_162053777">Other ECU is powered off</SD>
                                            <SD SI="Possible_Impact" TI="TI_298787442">Normal Assist</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_EPS.BV.BV_EPS.DOP.DD_DTCList.DTC.DTC_0xD30E86">
                                    <SHORT-NAME>DTC_0xD30E86</SHORT-NAME>
                                    <TROUBLE-CODE>13831814</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U130E86</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1680674703">Implausible Signal Received from TBOX_0x5C8</TEXT>
                                    <LEVEL>3</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1788665557">service at next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_18454213">Check TBOX_0x5C8</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1332037670">1) No Bus Off DTC Occurs
2) 9V &lt; VBatt &lt; 16V
3) 2500ms Later After IGN ON (Restart=500ms)
4) CommunicationControl Diag.Service = enableRxAndTx or enableRxAndDisableTx
5) ControlDTC Disable Diag.Service = On
6) TBOX_0x5C8 message is normally received</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1345117523">500</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_8792715">TBOX_OTA_ownCondchk == 0x3 Invalid</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1957416179">TBOX_OTA_ownCondchk != 0x3 Invalid</SD>
                                            <SD SI="Limp_home_Action" TI="TI_298787442">Normal Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_716227243">Other ECU sends invalid signals</SD>
                                            <SD SI="Possible_Impact" TI="TI_298787442">Normal Assist</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_EPS.BV.BV_EPS.DOP.DD_DTCList.DTC.DTC_0x60DF06">
                                    <SHORT-NAME>DTC_0x60DF06</SHORT-NAME>
                                    <TROUBLE-CODE>6348550</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C20DF06</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2087522592">HSM/SW Algorithm initialization Failure</TEXT>
                                    <LEVEL>1</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_398682085">Check SW</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1688849784"> - Local voltage is within normal range (9-16V) 
 - PwrMod == IGN ON </SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_601431817">During Start up </SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_372195596">The component shall set the DTC Immediately if the return value of HSM/SW Algorithm initialization failed or unsuccessful. Since initialization happens at the startup, the Failure will be latched until the same HSM initialization function is called again (i.e. entire ECU power cycle).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1171740628">The component shall not set any DTC if the HSM/SW initialization is Passed or successful</SD>
                                            <SD SI="Limp_home_Action" TI="TI_876878821">No Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1525693885">40dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_753161499">SW Algorithm initialization failed</SD>
                                            <SD SI="Possible_Impact" TI="TI_876878821">No Assist</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_EPS.BV.BV_EPS.DOP.DD_DTCList.DTC.DTC_0xD30D86">
                                    <SHORT-NAME>DTC_0xD30D86</SHORT-NAME>
                                    <TROUBLE-CODE>13831558</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U130D86</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_719068207">Implausible Signal Received from VCU_0x511</TEXT>
                                    <LEVEL>3</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_185634963">service at next halt </SD>
                                            <SD SI="Repair_Action" TI="TI_583640810">Check VCU_0x511</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_137065230">1) No Bus Off DTC Occurs
2) 9V &lt; VBatt &lt; 16V
3) 2500ms Later After IGN ON (Restart=500ms)
4) CommunicationControl Diag.Service = enableRxAndTx or enableRxAndDisableTx
5) ControlDTC Disable Diag.Service = On
6) VCU_0x511 message is normally received</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1345117523">500</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1957518322">VCU_VehMod == 0xF Invalid</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_645519462">VCU_VehMod != 0xF Invalid</SD>
                                            <SD SI="Limp_home_Action" TI="TI_298787442">Normal Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_716227243">Other ECU sends invalid signals</SD>
                                            <SD SI="Possible_Impact" TI="TI_298787442">Normal Assist</SD>
                                        </SDG>
                                    </SDGS>
