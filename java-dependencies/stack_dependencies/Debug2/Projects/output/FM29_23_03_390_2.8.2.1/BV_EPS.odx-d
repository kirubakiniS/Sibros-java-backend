                                    <LEVEL>3</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1579948055">depend on vehicle </SD>
                                            <SD SI="Repair_Action" TI="TI_1086940980">Trip counter updated </SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_380212341"> - Local voltage is within normal range (9-16V) 
 - PwrMod == IGN ON
 - BUS physical status</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1288428461">During Start up and failure to authenticate at any time</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_199200679">The component shall set the DTC if any of the below listed conditions occurs:
- Trip counter not updated across Ignition cycles 
- Trip counter data can not be written or read from NVM</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_800738930">The component shall clear the DTC if Trip counter is getting updated properly across Ignition cycles at least once or NVM Write/Read successful.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_298787442">Normal Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_570524298">Trip counter error</SD>
                                            <SD SI="Possible_Impact" TI="TI_298787442">Normal Assist</SD>
                                        </SDG>
                                    </SDGS>
