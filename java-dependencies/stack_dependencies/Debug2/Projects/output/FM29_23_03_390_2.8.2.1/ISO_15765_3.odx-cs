        <COMPARAMS>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_CanTransmissionTime"
                OID="1f9252db-b90a-4cc2-b512-47dce60c2458" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_CanTransmissionTime</SHORT-NAME>
                <LONG-NAME TI="TI_1282128988">CP_CanTransmissionTime</LONG-NAME>
                <DESC TI="TI_1380106003">
                    <p>If the timeout values are used which have been received by the ECU via session control response (0x50), the Can transmission time has to be added to the timeout values.</p>
                    <p>P2 = received P2 + CanTransmissionTime (contains delay for both transmission directions)</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>100000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ChangeSpeedCtrl"
                OID="10108aa0-95d9-46d5-947d-7605307faf06" PARAM-CLASS="COM">
                <SHORT-NAME>CP_ChangeSpeedCtrl</SHORT-NAME>
                <LONG-NAME TI="TI_1080674215">CP_ChangeSpeedCtrl</LONG-NAME>
                <DESC TI="TI_1812362005">
                    <p>Control the behaviour of the MVCI protocol module in processing speed change messages.</p>
                    <p>When this ComParam is enabled, the speed rate change will be activated on a successful Send or SendRecv ComPrimitive when the transmitted or received message matches the CP_ChangeSpeedMessage (baud rate as specified in CP_ChangeSpeedRate and termination resistor as specified in CP_ChangeSpeedResCtrl).</p>
                    <p>In the case of monitoring mode, when a receive PDU is bound to a Receive Only ComPrimitive, and this ComParam is enabled, the speed rate change will also be activated and the corresponding ComParams will be interpreted accordingly</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ChangeSpeedMessage"
                OID="261d694d-1eba-4fe5-b886-54b505fd33d4" PARAM-CLASS="COM">
                <SHORT-NAME>CP_ChangeSpeedMessage</SHORT-NAME>
                <LONG-NAME TI="TI_1292664331">CP_ChangeSpeedMessage</LONG-NAME>
                <DESC TI="TI_1577851918">
                    <p>Switch Speed Message</p>
                    <p>The message is monitored for transmit and receive. When this message is detected on the vehicle bus, the CP_ChangeSpeedRate and CP_ChangeSpeedResCtrl ComParams are processed.</p>
                    <p>NOTE: CP_ChangeSpeedCtrl is enabled for this ComParam to be active.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE/>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_BYTEFIELD_0_12_END_OF_PDU"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ChangeSpeedRate"
                OID="f53c2bcc-631a-4400-8535-89ab914761f2" PARAM-CLASS="COM">
                <SHORT-NAME>CP_ChangeSpeedRate</SHORT-NAME>
                <LONG-NAME TI="TI_725434879">CP_ChangeSpeedRate</LONG-NAME>
                <DESC TI="TI_236687363">
                    <p>The data rate to be used when switching speed rates</p>
                    <p>When changed, this value is copied to CP_Baudrate ComParam.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_Baud"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ChangeSpeedResCtrl"
                OID="2a051d2a-15ca-4237-8852-8ed67a0cd457" PARAM-CLASS="COM">
                <SHORT-NAME>CP_ChangeSpeedResCtrl</SHORT-NAME>
                <LONG-NAME TI="TI_1538540348">CP_ChangeSpeedResCtrl</LONG-NAME>
                <DESC TI="TI_377707549">
                    <p>This ComParam is used in conjunction with CP_ChangeSpeedCtrl.</p>
                    <p>This ComParam is used to control automatic loading or unloading of the physical resource resistor when a change speed message has been transmitted or received.</p>
                    <p>NOTE: For AUTO_UNLOAD_RESISTOR, it is intended that CP_TerminationType be set to the initial value configured at the time of a PDUConnect.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Not used</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT8_ChangeSpeedResCtrl"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ChangeSpeedTxDelay"
                OID="9838c477-e464-46a6-a543-d017c3e8ef4a" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_ChangeSpeedTxDelay</SHORT-NAME>
                <LONG-NAME TI="TI_1818490792">CP_ChangeSpeedTxDelay</LONG-NAME>
                <DESC TI="TI_230585484">
                    <p>Minimum amount of time to wait before allowing the next transmit message on the Vehicle Bus after the successful transmission of a baud rate change message</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_CyclicRespTimeout"
                OID="acf9fd9c-b071-484f-adfc-9080dfd8f2ef" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_CyclicRespTimeout</SHORT-NAME>
                <LONG-NAME TI="TI_1213007906">CP_CyclicRespTimeout</LONG-NAME>
                <DESC TI="TI_843369679">
                    <p>This ComParam is used for ComPrimitives that have a NumRecvCycles set to IS-CYCLIC (-1, infinite).</p>
                    <p>The timer is enabled after the first positive response is received from an ECU. If CP_CyclicRespTimeout = 0, there is no receive timing enabled for the infinite receive ComPrimitive.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_EnablePerformanceTest"
                OID="5d323080-70a8-401b-9fa9-52029fa33460" PARAM-CLASS="COM">
                <SHORT-NAME>CP_EnablePerformanceTest</SHORT-NAME>
                <LONG-NAME TI="TI_1159759302">CP_EnablePerformanceTest</LONG-NAME>
                <DESC TI="TI_972151617">
                    <p>This ComParam (when enabled) will place the tester into a performance measurement mode.</p>
                    <p>Measurements will be collected during a normal ComPrimitive communications session.</p>
                    <p>ComParams such as P1Min, P2Min, Br, Cs will be tested in this mode. Once the testing is disabled, results of the testing will be returned to the client application.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_Loopback"
                OID="fb326658-5a6a-4078-bc45-e2bd4bc63e9d" PARAM-CLASS="COM">
                <SHORT-NAME>CP_Loopback</SHORT-NAME>
                <LONG-NAME TI="TI_1204946144">CP_Loopback</LONG-NAME>
                <DESC TI="TI_1423400667">
                    <p>Echo Transmitted messages in the receive queue, including periodic messages.</p>
                    <p>Loopback messages shall only be sent after successful transmission of a message.</p>
                    <p>Loopback frames are not subject to message filtering.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Off</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Off_On"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_ModifyTiming"
                OID="ef77d547-7f6d-4d8f-b580-344fc3269c2e" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_ModifyTiming</SHORT-NAME>
                <LONG-NAME TI="TI_998619410">CP_ModifyTiming</LONG-NAME>
                <DESC TI="TI_424295413">
                    <p>This parameter signals the D-PDU API to automatically modify timing parameters based on a response from the ECU.</p>
                    <p>For ISO 14230-2 this would apply to service 0x83/0xC3 with TPI of 1, 2 or 3.</p>
                    <p>For ISO 15765-3 this would apply to service 0x10/0x50. For functional addressing mode, the worst case timing parameter returned by the responding ECUs shall be used.</p>
                    <p>Based on the protocol, the following parameters are modified when a positive ECU response is received:</p>
                    <p>- CP_P2Max</p>
                    <p>- CP_P2Min</p>
                    <p>- CP_P2Star</p>
                    <p>- CP_P3Min</p>
                    <p>- CP_P4Min</p>
                    <p>NOTE: The values returned by an ECU are in a different time resolution than the ComParams to be automatically modified. The values will be reinterpreted from the protocol specified time resolution to the 1us resolution specified in the D-PDU API.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_P2Max"
                OID="cafb0854-82ed-4faa-beea-2dd42ee1642c" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_P2Max</SHORT-NAME>
                <LONG-NAME TI="TI_1960496162">CP_P2Max</LONG-NAME>
                <DESC TI="TI_1697107408">
                    <p>Timeout in receiving an expected frame
after a successful transmit complete</p>
                    <p>Also used for
multiple ECU responses</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>150000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT27_0_125000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_P2Min"
                OID="91b8c158-66ce-42b8-bbce-960f0070b07e" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_P2Min</SHORT-NAME>
                <LONG-NAME TI="TI_1710411525">CP_P2Min</LONG-NAME>
                <DESC TI="TI_1785396855">
                    <p>This sets the minimum time between tester request and ECU responses, or two ECU responses.</p>
                    <p>After the request, the interface shall be capable of handling an immediate response (P2_min=0). For subsequent responses, a byte received after P1_MAX shall be considered as the start of the subsequent response.</p>
                    <p>This is a performance requirement ComParam.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT18_0_250000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_P2Star"
                OID="1bd3a504-6eba-4b1b-81a3-01532de95193" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_P2Star</SHORT-NAME>
                <LONG-NAME TI="TI_1687466513">CP_P2Star</LONG-NAME>
                <DESC TI="TI_1679546888">
                    <p>Timeout for the client to expect the start of the response message after the reception of a negative response message (indicated via N_USData.ind) with response code 0x78 (enhanced response timing)</p>
                    <p>See CP_RC78Handling for details describing 0x78 0x7F handling.</p>
                    <p>This parameter is used for all protocols that support the negative response code 0x78. For some protocols it is used instead of the recommended P3Max parameter.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>5050000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT30_0_655350000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_P3Func"
                OID="99db131a-be03-4d56-a022-7fc3cd11617c" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_P3Func</SHORT-NAME>
                <LONG-NAME TI="TI_442942430">CP_P3Func</LONG-NAME>
                <DESC TI="TI_539456168">
                    <p>Minimum time for the client to wait after the successful transmission of a functionally addressed request message (indicated via N_USData.con), before it can transmit the next functionally addressed request message, in case no response is required, or the requested data is only supported by a subset of thefunctionally addressed servers</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>50000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT27_0_125000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_P3Phys"
                OID="975ab8be-1f9f-4af7-a34b-f13587dc07de" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_P3Phys</SHORT-NAME>
                <LONG-NAME TI="TI_488253781">CP_P3Phys</LONG-NAME>
                <DESC TI="TI_534487200">
                    <p>Minimum time for the client to wait after the successful transmission of a physically addressed request message (indicated via N_USData.con) with no response required before it can transmit the next physically-addressed request message</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>50000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT27_0_125000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC21CompletionTimeout"
                OID="a8aa089c-cfd8-416d-ade6-a8ddd2c89fe9" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC21CompletionTimeout</SHORT-NAME>
                <LONG-NAME TI="TI_976791362">CP_RC21CompletionTimeout</LONG-NAME>
                <DESC TI="TI_1093126153">
                    <p>Time period the tester accepts repeated negative responses with response code 0x21 and repeats the same request</p>
                    <p>Timer is started after reception of first negative response.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1300000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC21Handling"
                OID="3de3dfc3-57ee-4061-9319-a8bc147d6800" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC21Handling</SHORT-NAME>
                <LONG-NAME TI="TI_722632200">CP_RC21Handling</LONG-NAME>
                <DESC TI="TI_264051769">
                    <p>Repetition mode in case of response code 0x7F XX 0x21</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT2_0_2_RC21Handling"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC21RequestTime"
                OID="b15219cd-3248-4caa-b783-ea9e3688b63f" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC21RequestTime</SHORT-NAME>
                <LONG-NAME TI="TI_1027232384">CP_RC21RequestTime</LONG-NAME>
                <DESC TI="TI_2119127735">
                    <p>Time between negative response with response code 0x21 and the retransmission of the same request</p>
                    <p>If CP_P3Min is greater than CP_RC21RequestTime, the time delay prior to the retransmission of the same request will be CP_P3Min.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>200000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT27_0_100000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC23CompletionTimeout"
                OID="93ce4403-06b7-4b11-8bf2-79737cacc2ce" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC23CompletionTimeout</SHORT-NAME>
                <LONG-NAME TI="TI_1966448898">CP_RC23CompletionTimeout</LONG-NAME>
                <DESC TI="TI_625606704">
                    <p>Time period the tester accepts repeated negative responses with response code 0x23 and repeats the same request</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC23Handling"
                OID="3f1a1bad-ba32-4fbc-b50e-422b62652637" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC23Handling</SHORT-NAME>
                <LONG-NAME TI="TI_1819115795">CP_RC23Handling</LONG-NAME>
                <DESC TI="TI_1382948007">
                    <p>Repetition mode in case of response code 0x7F XX 0x23</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT2_0_2_RC23Handling"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC23RequestTime"
                OID="2bcfbd4e-f4f4-4b20-a61c-ea438c034375" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC23RequestTime</SHORT-NAME>
                <LONG-NAME TI="TI_1551056709">CP_RC23RequestTime</LONG-NAME>
                <DESC TI="TI_403340708">
                    <p>The time the D-PDU API waits to re-request the message when receiving a negative response code 0x23</p>
                    <p>For some protocols (SAE_J1850_VPW) it is possible to get a positive response after receiving a negative response code 0x23, so the D-PDU API uses this ComParam as the time to receive a possible positive response before making the re-request.</p>
                    <p>On a positive response within this time, the re-request is cancelled. The D-PDU API postpones the re-request until the timeout of CP_RC23RequestTime (or a CP_P3Min timeout, in case CP_P3Min is greater than CP_RC23RequestTime).</p>
                    <p>For ISO 14230-3, there will be no positive response following a RC23 therefore the D-PDU API is expected to always make a re-request if enabled (CP_RC23Handling != 0).</p>
                    <p>The cycle of receiving negative response code 0x23 and retransmitting the request continues until CP_RC23CompletionTimeout expires (applicable only if CP_RC23Handling is set to 1).</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>200000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT27_0_100000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC78CompletionTimeout"
                OID="ccea648f-44ee-4813-9d67-32a9ee0f47c6" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC78CompletionTimeout</SHORT-NAME>
                <LONG-NAME TI="TI_302538916">CP_RC78CompletionTimeout</LONG-NAME>
                <DESC TI="TI_372498321">
                    <p>Time period the tester accepts repeated negative responses with response code 0x78 and waits for a positive response further on</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>25000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RC78Handling"
                OID="33231662-cb1a-4018-99ca-d163889cd2c4" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RC78Handling</SHORT-NAME>
                <LONG-NAME TI="TI_24552745">CP_RC78Handling</LONG-NAME>
                <DESC TI="TI_823991574">
                    <p>Handling of 0x7F XX 0x78 ResponseTimeout and 0x78 Repetitions</p>
                    <p>The receive timeout value will be CP_P2Star. This timer will be reset on each consecutive reception of the 0x7F 0x78 response.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Continue unlimited</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT2_0_2_RC78Handling"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RCByteOffset"
                OID="d9bf4886-2ffe-4f94-bf9b-b17ee4b16f33" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RCByteOffset</SHORT-NAME>
                <LONG-NAME TI="TI_2066076217">CP_RCByteOffset</LONG-NAME>
                <DESC TI="TI_159851581">
                    <p>This parameter is used by the MVCI Protocol Handlers to offset into the received negative response message (0x7F) to retrieve the response code byte.</p>
                    <p>Most protocols as a default place the response code as the last byte of the message. There are some protocols which place the response code after the Service Id (offset = 1).</p>
                    <p>A range is provided to allow for different negative response configurations</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Last byte</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT32_1_4294967295_RCByteOffset"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_RepeatReqCountApp"
                OID="aec06792-2b88-49d0-904a-28775279d837" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_RepeatReqCountApp</SHORT-NAME>
                <LONG-NAME TI="TI_292673333">CP_RepeatReqCountApp</LONG-NAME>
                <DESC TI="TI_1304893704">
                    <p>This ComParam contains a counter to enable a re-transmission of the last request when either a transmit, receive error, or timeout with no response is detected.</p>
                    <p>This only applies to the application layer.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT17_0_127500"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_StartMsgIndEnable"
                OID="edd17568-b0cc-4815-af5e-0d7fe245e1c2" PARAM-CLASS="COM">
                <SHORT-NAME>CP_StartMsgIndEnable</SHORT-NAME>
                <LONG-NAME TI="TI_1795001703">CP_StartMsgIndEnable</LONG-NAME>
                <DESC TI="TI_1492638622">
                    <p>Start Message Indication Enable</p>
                    <p>Upon receiving a first frame of a multi-frame message (ISO 15765), or upon receiving a first byte of a UART message, an indication will be set in the RX result item.</p>
                    <p>No data bytes will accompany the result item.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_SuspendQueueOnError"
                OID="ac342727-7f3c-4223-b6aa-ade6a7a1cd61" PARAM-CLASS="ERRHDL">
                <SHORT-NAME>CP_SuspendQueueOnError</SHORT-NAME>
                <LONG-NAME TI="TI_372932771">CP_SuspendQueueOnError</LONG-NAME>
                <DESC TI="TI_804222930">
                    <p>This ComParam is used as a temporary ComParam for services that require a positive response before any further Com Primitives can be executed.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Do not suspend</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_SuspendQueueOnError"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_SwCan_HighVoltage"
                OID="18aefb24-8d65-4ae0-86ef-74280eeee0b6" PARAM-CLASS="COM">
                <SHORT-NAME>CP_SwCan_HighVoltage</SHORT-NAME>
                <LONG-NAME TI="TI_657965139">CP_SwCan_HighVoltage</LONG-NAME>
                <DESC TI="TI_366283754">
                    <p>Indicates that the Single Wire CAN message should be transmitted as a High-Voltage Message.</p>
                    <p>Simultaneously transmitting in high voltage and high speed mode will result in undefined behaviour.</p>
                    <p>This ComParam is only applicable when the Bus Type selected is SAE_J2411_SWCAN.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Normal</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_SwCan_HighVoltage"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentAddrMode"
                OID="237fcacb-9d85-43e8-93fc-2f70801c9b13" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentAddrMode</SHORT-NAME>
                <LONG-NAME TI="TI_641703693">CP_TesterPresentAddrMode</LONG-NAME>
                <DESC TI="TI_789300816">
                    <p>Addressing Mode to be used for periodic Tester Present messages</p>
                    <p>Uses the PhysReqxxx or FuncReqxxx ComParams.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Functional</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_TesterPresentAddrMode"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentExpPosResp"
                OID="e7c1c1a0-03e3-4dcd-b988-32ab39a167a9" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentExpPosResp</SHORT-NAME>
                <LONG-NAME TI="TI_1998298317">CP_TesterPresentExpPosResp</LONG-NAME>
                <DESC TI="TI_406138336">
                    <p>Define the expected ECU positive response to a Tester Present Message.</p>
                    <p>This is only applicable if CP_TesterPresentReqRsp is set to 1 (ECU responses are expected on a Tester Present Message).</p>
                    <p>No header bytes or checksum bytes are included. Only the ParamActLen bytes in the array will be compared to the received ECU data.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE/>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_BYTEFIELD_0_12_END_OF_PDU"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentExpNegResp"
                OID="98bf22d7-0d25-4bb0-b322-58a942b72614" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentExpNegResp</SHORT-NAME>
                <LONG-NAME TI="TI_2056792583">CP_TesterPresentExpNegResp</LONG-NAME>
                <DESC TI="TI_246417268">
                    <p>Define the expected ECU negative response to a Tester Present Message.</p>
                    <p>This is only applicable if CP_TesterPresentReqRsp is set to 1 (ECU responses are expected on a Tester Present Message).</p>
                    <p>No header bytes or checksum bytes are included.</p>
                    <p>When a negative response is received to a tester present message, which cannot be handled by the MVCI Protocol module (See RC 21, RC 23 and RC 78), the MVCI protocol module should report a Tester Present Error, but continue sending Tester Present Messages. (See PDU_ERR_EVT_TESTER_PRESENT_ERROR)</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE/>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_BYTEFIELD_0_12_END_OF_PDU"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentHandling"
                OID="a7038f11-7558-4eb1-a7f8-e34660ebe316" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentHandling</SHORT-NAME>
                <LONG-NAME TI="TI_502372010">CP_TesterPresentHandling</LONG-NAME>
                <DESC TI="TI_1235187687">
                    <p>Define Tester Present message generation settings</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Enabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentMessage"
                OID="90127b1a-95ff-4cfa-bb7b-87c708d8cb15" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentMessage</SHORT-NAME>
                <LONG-NAME TI="TI_1592117667">CP_TesterPresentMessage</LONG-NAME>
                <DESC TI="TI_131630789">
                    <p>Define the Tester Present Message</p>
                    <p>This message data does not include any header bytes or checksum information.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>3E80</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_BYTEFIELD_0_12_END_OF_PDU"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentReqRsp"
                OID="2cb04ced-1238-4d1a-803e-5d88fc2a85fc" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentReqRsp</SHORT-NAME>
                <LONG-NAME TI="TI_1461147319">CP_TesterPresentReqRsp</LONG-NAME>
                <DESC TI="TI_2012713539">
                    <p>Define settings for handling Tester Present ECU responses</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>No response</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_TesterPresentReqRsp"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentSendType"
                OID="cd643b8f-dc82-46aa-9ef6-ba673f0e0071" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentSendType</SHORT-NAME>
                <LONG-NAME TI="TI_1623914921">CP_TesterPresentSendType</LONG-NAME>
                <DESC TI="TI_829188469">
                    <p>Define settings for the type of tester present transmits</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Periodic</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_TesterPresentSendType"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TesterPresentTime"
                OID="78057ab2-23bf-423e-806e-da6a16f8a23d" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CP_TesterPresentTime</SHORT-NAME>
                <LONG-NAME TI="TI_1990793737">CP_TesterPresentTime</LONG-NAME>
                <DESC TI="TI_764420749">
                    <p>Time between Tester Present messages, or Time bus shall be idle before transmitting a Tester Present Message</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>2000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT25_0_30000000_MicroSecond"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_TransmitIndEnable"
                OID="8ade58f2-f976-45e5-b44a-62b81826d6d7" PARAM-CLASS="COM">
                <SHORT-NAME>CP_TransmitIndEnable</SHORT-NAME>
                <LONG-NAME TI="TI_1481772244">CP_TransmitIndEnable</LONG-NAME>
                <DESC TI="TI_122720622">
                    <p>Transmit Indication Enable</p>
                    <p>On completion of a transmit message by the protocol, an indication will be set in the RX_FLAG result item.</p>
                    <p>No data bytes will accompany the result item.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CPM_TesterPresentSerialization.COMPARAM"
                OID="89a24708-2414-487a-9c2c-48bd906edb8b" PARAM-CLASS="TESTER_PRESENT">
                <SHORT-NAME>CPM_TesterPresentSerialization</SHORT-NAME>
                <LONG-NAME TI="TI_364706502">CPM_TesterPresentSerialization</LONG-NAME>
                <DESC TI="TI_2141934506">
                    <p>If enabled, asynchronous functional Tester Presents w/o response will be serialized with normal ComPrimitives.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
        </COMPARAMS>
        <COMPLEX-COMPARAMS>
            <COMPLEX-COMPARAM ALLOW-MULTIPLE-VALUES="true"
                CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_15765_3.CP_SessionTimingOverride"
                OID="d1a6cd2f-6ebf-4979-a542-47d3d963c085" PARAM-CLASS="TIMING">
                <SHORT-NAME>CP_SessionTimingOverride</SHORT-NAME>
                <LONG-NAME TI="TI_1446666977">CP_SessionTimingOverride</LONG-NAME>
                <DESC TI="TI_1712654535">
                    <p>This parameter signals the D-PDU API to override the response from any ECUs to a Session Timing request (See CP_SessionTiming_Ecu and CP_ModifyTiming).</p>
                    <p>The timing parameters are to be used for the ECU protocol application layer ISO15765_3 in response to a service 0x10 (Set Diagnostic Session).</p>
                    <p>The ECU returns the session timing information on a positive response to the service.</p>
                    <p>If CP_ModifyTiming is enabled and CP_SessionTimingOverride is not empty (ParamActEntries != 0), then the MVCI protocol module will use data in this ComParam instead of the data returned in a positive reponse from the ECUs.</p>
                </DESC>
                <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                    ID="ISO_15765_3.CP_SessionTimingOverride_P2Max_High"
                    OID="a37ee2cb-679e-48fa-8536-02ef20917d20" PARAM-CLASS="TIMING">
                    <SHORT-NAME>CP_SessionTimingOverride_P2Max_High</SHORT-NAME>
                    <LONG-NAME TI="TI_1243949945">CP_SessionTimingOverride_P2Max_High</LONG-NAME>
                    <DESC TI="TI_743572749">
                        <p>1 ms resolution</p>
                        <p>High byte of the default P2Can_Server_max timing supported by the server for the activated diagnostic session</p>
                        <p>Used for ComParam CP_P2Max</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="LINEAR_UINT8_UINT32_256000x_MicroSecond"/>
                </COMPARAM>
                <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                    ID="ISO_15765_3.CP_SessionTimingOverride_P2Max_Low"
                    OID="7a97f584-4a0d-4dfc-b4f3-0c6aeff6b332" PARAM-CLASS="TIMING">
                    <SHORT-NAME>CP_SessionTimingOverride_P2Max_Low</SHORT-NAME>
                    <LONG-NAME TI="TI_150505716">CP_SessionTimingOverride_P2Max_Low</LONG-NAME>
                    <DESC TI="TI_159970032">
                        <p>1 ms resolution</p>
                        <p>Low byte of the default P2Can_Server_max timing supported by the server for the activated diagnostic session</p>
                        <p>Used for ComParam CP_P2Max</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="LINEAR_UINT8_UINT32_1000x_MicroSecond"/>
                </COMPARAM>
                <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                    ID="ISO_15765_3.CP_SessionTimingOverride_P2Star_High"
                    OID="ae620734-93e7-4dd6-bcbf-1135da9a5ce3" PARAM-CLASS="TIMING">
                    <SHORT-NAME>CP_SessionTimingOverride_P2Star_High</SHORT-NAME>
                    <LONG-NAME TI="TI_79704982">CP_SessionTimingOverride_P2Star_High</LONG-NAME>
                    <DESC TI="TI_1938248880">
                        <p>10 ms resolution</p>
                        <p>High byte of the enhanced (NRC 78 hex) P2Can_Server_max supported by the
server for the activated diagnostic session</p>
                        <p>Used for ComParam CP_P2Star</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="LINEAR_UINT8_UINT32_2560000x_MicroSecond"/>
                </COMPARAM>
                <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                    ID="ISO_15765_3.CP_SessionTimingOverride_P2Star_Low"
                    OID="b0a395f3-d025-422b-b303-7eee74655ecf" PARAM-CLASS="TIMING">
                    <SHORT-NAME>CP_SessionTimingOverride_P2Star_Low</SHORT-NAME>
                    <LONG-NAME TI="TI_1193779358">CP_SessionTimingOverride_P2Star_Low</LONG-NAME>
                    <DESC TI="TI_105197080">
                        <p>10 ms resolution</p>
                        <p>Low byte of the enhanced (NRC 78 hex) P2Can_Server_max supported by the
server for the activated diagnostic session</p>
                        <p>Used for ComParam CP_P2Star</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="LINEAR_UINT8_UINT32_10000x_MicroSecond"/>
                </COMPARAM>
                <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                    ID="ISO_15765_3.CP_SessionTimingOverride_SessionNumber"
                    OID="3684699c-b4ab-446e-acdd-3cbae6f854f4" PARAM-CLASS="TIMING">
                    <SHORT-NAME>CP_SessionTimingOverride_SessionNumber</SHORT-NAME>
                    <LONG-NAME TI="TI_260318913">CP_SessionTimingOverride_SessionNumber</LONG-NAME>
                    <DESC TI="TI_796702187">
                        <p>Session Number, for the diagnostic session of ISO 15765-3</p>
                    </DESC>
                    <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                    <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT7_HEX"/>
                </COMPARAM>
                <COMPLEX-PHYSICAL-DEFAULT-VALUE/>
            </COMPLEX-COMPARAM>
        </COMPLEX-COMPARAMS>
