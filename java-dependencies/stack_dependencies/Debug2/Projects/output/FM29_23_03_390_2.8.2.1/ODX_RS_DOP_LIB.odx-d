                        <DOC-REVISION>
                            <TEAM-MEMBER-REF ID-REF="id-59d420c0-b704-11de-8a39-0800200c9a66"/>
                            <REVISION-LABEL>000.000.001</REVISION-LABEL>
                            <STATE>draft</STATE>
                            <DATE>2009-10-27T10:51:38</DATE>
                            <TOOL>DatabaseDesigner</TOOL>
                            <MODIFICATIONS>
                                <MODIFICATION>
                                    <CHANGE>Merge of DOPs of companies BMW and VW/Audi</CHANGE>
                                    <REASON>Supply of DOPs for ODX-RS</REASON>
                                </MODIFICATION>
                            </MODIFICATIONS>
                        </DOC-REVISION>
                        <DOC-REVISION>
                            <TEAM-MEMBER-REF ID-REF="id-59d420c0-b704-11de-8a39-0800200c9a66"/>
                            <REVISION-LABEL>000.000.002</REVISION-LABEL>
                            <STATE>draft</STATE>
                            <DATE>2010-07-15T12:28:06</DATE>
                            <TOOL>DatabaseDesigner</TOOL>
                            <MODIFICATIONS>
                                <MODIFICATION>
                                    <CHANGE>Named the DOPs according the rules of the document ODX_AG_Subgroup_Recommendations.doc. The rules are described in chapter - NAMING CONVENTION FOR DATA-OBJECT-PROPS TO BUILD THE LONG-NAME -</CHANGE>
                                    <REASON>Supply of DOPs for ODX-RS</REASON>
                                </MODIFICATION>
                            </MODIFICATIONS>
                        </DOC-REVISION>
                        <DOC-REVISION>
                            <TEAM-MEMBER-REF ID-REF="id-59d420c0-b704-11de-8a39-0800200c9a66"/>
                            <REVISION-LABEL>000.000.003</REVISION-LABEL>
                            <STATE>draft</STATE>
                            <DATE>2010-07-23T17:31:23</DATE>
                            <TOOL>DatabaseDesigner</TOOL>
                            <MODIFICATIONS>
                                <MODIFICATION>
                                    <CHANGE>Added OIDs for every DOP. These UUIDs were generated according to The Leach, Mealling and Salz Draft Using the random version (version 4). See also http://www.famkruithof.net/uuid/uuidgen</CHANGE>
                                    <REASON>Supply of DOPs for ODX-RS</REASON>
                                </MODIFICATION>
                            </MODIFICATIONS>
                        </DOC-REVISION>
