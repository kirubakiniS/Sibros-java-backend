                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1365154303">This fault will be reported if the GPIO is switched off but the overcurrent bit of the ASIC remains set (GPIO is malfunctioning).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_557934059">The root cause is an overcurrent event which cannot be resolved by switching the affected GPIO.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245DA1" OID="50a3fe5e-5100-4ab7-968e-e5b2a8b96185">
                                    <SHORT-NAME>DTCC245DA1</SHORT-NAME>
                                    <TROUBLE-CODE>6577569</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245DA1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1430226018">Microcontroller memory guard has detected a GRAM guard violation event.</TEXT>
                                    <SDGS>
