                                <DTC ID="DTCC2451D1" OID="b70a5434-4d21-40bb-842f-86bf06ab1dc2">
                                    <SHORT-NAME>DTCC2451D1</SHORT-NAME>
                                    <TROUBLE-CODE>6574545</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451D1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1028835195">The right APB motor stalls during release.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_205811128">The MGU current is checked permanently. A too high temperature must be avoided to protect the power stage. With a temperature model the heat up and cool down behaviour is estimated. If the estimated temperature is beyond a critical threshold, then a failure message is generated. During a motor stall the temperature increases rapidely, that means, that a MGU is switched off after a short time.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
