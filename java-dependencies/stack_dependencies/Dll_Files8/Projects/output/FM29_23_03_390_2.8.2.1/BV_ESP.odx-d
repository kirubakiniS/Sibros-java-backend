                                <DTC ID="DTCC2461A4" OID="5650e7d4-96ff-4abb-9472-bc65be88da9e">
                                    <SHORT-NAME>DTCC2461A4</SHORT-NAME>
                                    <TROUBLE-CODE>6578596</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A4</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_957086962">CRC fail bit for Trimming data in OTP area is set during cyclic operation</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_922199621">CRC fail bit set continuously for 3 times</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
