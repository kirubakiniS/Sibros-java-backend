                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC248CA1" OID="b2f5a046-b1bb-42d3-a19a-4af0f15bfa7f">
                                    <SHORT-NAME>DTCC248CA1</SHORT-NAME>
                                    <TROUBLE-CODE>6589601</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C248CA1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_620795226">The test of the charge-pump has detected a failure (e.g. missing capacitor)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1148090746">Test of charge pump performance (charge time and discharge time), capacity of buffer capacitor is above a defined threshold. Charge pump undervoltage bits are monitored.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1903574721">Capacity of charge pump buffer or performance of charge pump is not sufficient.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2488A1" OID="42f5b61b-1eac-4397-af61-ba5f1aa9e4b9">
                                    <SHORT-NAME>DTCC2488A1</SHORT-NAME>
                                    <TROUBLE-CODE>6588577</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2488A1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1508003571">Short circuit beteen Qx pin and MRAuC pin are detected</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1108267199">MRAuC is actuated (with Qx On) for a short time and check MRG state via MRG_on_SPI bit. If the bit is 0, the failure is logged. The test shall run before VR is switched on for the first time and HyEn is switched on, hence during FSLT.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_188088393">Short circuit between Qx pin and MRAuC pin</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2486A0" OID="61efaccf-808f-41b5-ba54-5e217ac4696b">
                                    <SHORT-NAME>DTCC2486A0</SHORT-NAME>
                                    <TROUBLE-CODE>6588064</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2486A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1150119017">Clockin monitor of system IC reports wrong clockin failure status to uC</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1327292723">The failsafe logic test tests whether the clockin monitor of the system IC detects a too high, a too low or a correct clockin frequency. This failure is logged if the feedback to the uC does not show the expected clockin failure state.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_204140394">Erroneous safety logic (The clockin monitor of the system IC reports wrong clockin failure status to the uC)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2486A1" OID="cbe24b3d-97b1-42fb-a884-2afd9f0dfde8">
                                    <SHORT-NAME>DTCC2486A1</SHORT-NAME>
                                    <TROUBLE-CODE>6588065</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2486A1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_337128001">Contrary to spec BIST state machine of system IC is started by a wrong BIST command</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_317203969">The failsafe logic test tests whether the BIST state machine does detect and suppress a wrong BIST command value. This failure is logged if the watchdog of the system chip is triggered by the wrong BIST command value.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_191965652">Erroneous safety logic (the BIST state machine of the system chip could be activated by a wrong BIST command value)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2486A2" OID="8b224012-ff66-40f1-bb9a-dcb8260cad2a">
                                    <SHORT-NAME>DTCC2486A2</SHORT-NAME>
                                    <TROUBLE-CODE>6588066</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2486A2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1264758553">Missing BIST trigger didn't swicth off hy. or electrically as expected</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_910471159">The failsafe logic test tests whether the watchdog of the system chip can be started with the first watchdog trigger signal from the BIST state machine. Additionally it is tested that the watchdog switches off hydraulically respective electrically if the BIST state machine is not triggered during the corresponding timeout times.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_346956636">Erroneous safety logic (e.g. BIST of system IC either does not detect a correct BIST command or missing BIST commands)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2486A3" OID="b44f58a1-6c8e-4e65-ad7d-9c4fe289f876">
                                    <SHORT-NAME>DTCC2486A3</SHORT-NAME>
                                    <TROUBLE-CODE>6588067</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2486A3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_612588080">BIST didn't switch off electrically after too much received wrong BIST commands</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1783254493">The failsafe logic test tests that after 3 wrong BIST commands the BIST failure counter counted up to its max. value and that the BIST state machine switches off electrically consequently.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_805132573">Erroneous safety logic (BIST of system IC does not switch off electrically after too much received wrong BIST commands)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
