                                <DTC ID="DTCC2451CD" OID="0a2da9c9-22ed-4f34-b4c5-639900dcf71b">
                                    <SHORT-NAME>DTCC2451CD</SHORT-NAME>
                                    <TROUBLE-CODE>6574541</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451CD</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_685557954">emergency supply switch overload detected (left)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1881498728">The sum of both MGU currents is checked permanently. A too high temperature must be avoided to protect the emergency power stage. With a temperature model the heat up and cool down behaviour is estimated. If the estimated temperature is beyond a critical threshold, then a failure message is generated.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_132147861">thermic overload of emergency supply switch</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2451CE" OID="01701482-156d-46ec-9556-ca4fb505dfd0">
                                    <SHORT-NAME>DTCC2451CE</SHORT-NAME>
                                    <TROUBLE-CODE>6574542</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451CE</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1848632172">The left APB motor stalls during release.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_205811128">The MGU current is checked permanently. A too high temperature must be avoided to protect the power stage. With a temperature model the heat up and cool down behaviour is estimated. If the estimated temperature is beyond a critical threshold, then a failure message is generated. During a motor stall the temperature increases rapidely, that means, that a MGU is switched off after a short time.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1656175963">mechanical clamping of MGU or spindle</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2451CF" OID="1148891f-2460-475c-aded-ae8ce074e17a">
