                                <DTC ID="DTCC2476A9" OID="20cfb84d-f85d-469e-a67f-e16ccbbf49bb">
                                    <SHORT-NAME>DTCC2476A9</SHORT-NAME>
                                    <TROUBLE-CODE>6583977</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2476A9</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_683125768">VR can not be switched off</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1381509797">Comparing UVR and UBVR</SD>
