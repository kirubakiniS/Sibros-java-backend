                                <DTC ID="DTCC2450A4" OID="45230229-404d-41dd-93ac-90257420f372">
                                    <SHORT-NAME>DTCC2450A4</SHORT-NAME>
                                    <TROUBLE-CODE>6574244</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2450A4</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_578837333">OBD failures that will be set after second occurence</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_437130873">The failure is set if the value of the longitudinal acceleration is less than a specific threshold %{ -15 | m/s^2 | 0 | P_ibax_AxAnschlMax }%.</SD>
