                            <DIAG-CODED-TYPE BASE-DATA-TYPE="A_UINT32" IS-HIGHLOW-BYTE-ORDER="true" xsi:type="STANDARD-LENGTH-TYPE">
                                <BIT-LENGTH>16</BIT-LENGTH>
                            </DIAG-CODED-TYPE>
                            <PHYSICAL-TYPE BASE-DATA-TYPE="A_UNICODE2STRING"/>
                            <INTERNAL-CONSTR>
                                <LOWER-LIMIT INTERVAL-TYPE="CLOSED">2384</LOWER-LIMIT>
                                <UPPER-LIMIT INTERVAL-TYPE="CLOSED">61845</UPPER-LIMIT>
