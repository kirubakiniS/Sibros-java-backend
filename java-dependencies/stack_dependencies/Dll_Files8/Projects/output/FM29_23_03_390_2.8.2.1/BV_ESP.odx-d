                                <DTC ID="DTCC248DA3" OID="1263925d-e25b-4eb9-b2e7-f75f6aec08f5">
                                    <SHORT-NAME>DTCC248DA3</SHORT-NAME>
                                    <TROUBLE-CODE>6589859</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C248DA3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_297606671">Runtime overload</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
