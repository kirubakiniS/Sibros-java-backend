                                <DTC ID="DTCC246BA5" OID="1d691f05-0014-404d-aa1a-041a32ad278b">
                                    <SHORT-NAME>DTCC246BA5</SHORT-NAME>
                                    <TROUBLE-CODE>6581157</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246BA5</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1329735560">WSS FL sensor line failure or ASIC failure</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_98619114">HW monitoring by Multi IC detects WSS_FL line failure (no exact failure reason detectable).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1798498388">WSS_FL line failure (no exact reason for Line failure is detected).The bits of ASIC, which are used to signal a line failure, have an undefined state.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246BA6" OID="5d75fa11-738a-4d06-994e-b33918a245c9">
                                    <SHORT-NAME>DTCC246BA6</SHORT-NAME>
                                    <TROUBLE-CODE>6581158</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246BA6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1106498947">WSS test failure of WSS_FL (Short circuit supply line to UBATT, short circuits between sensors, any line failure)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1855443637">Software /Hardware trigger Wss test is done by Multi IC to check for WSS_FL(Short circuit of WSS_supply line to UBATT, short circuits between sensor lines, or any WSS line failure).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1837131583">Short circuit WSS_FL to another WSS.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246BA7" OID="e583d379-38d2-4f14-bad8-029ee68b5748">
                                    <SHORT-NAME>DTCC246BA7</SHORT-NAME>
                                    <TROUBLE-CODE>6581159</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246BA7</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1058131201">Incorrect Gap between sensor element and the cog wheel on FL wheel</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1799670174">The air gap limit bit of the ASIC is monitored and deviations in the bit are notified.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_622265166">Intelligent sensor signalled an incorrect airgap between transmitter wheel(Front Left) and sensor itself.Magnetic flux density measured by sensor is incorrect.This typically points to misassembly or wheel vibrations on WSS_FL.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246BA8" OID="ded51a1d-819b-4bb1-8cd2-990f830aa811">
                                    <SHORT-NAME>DTCC246BA8</SHORT-NAME>
                                    <TROUBLE-CODE>6581160</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246BA8</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_62090945">WSS FL DMA buffer noise (large amount of edges)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1599233983">Status of the DMA TU buffer is monitored to detect overflow due to too high frequency on WSS_FL.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_919511954">DMA buffer overflow (when all timestamps for every edge, could not be logged in memory).This may be due to defect of the WSS sensor(WSS_FL) or internal hardware defect.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246BA9" OID="bba2b6e7-1508-402c-95cd-ac0d00c1e6f0">
                                    <SHORT-NAME>DTCC246BA9</SHORT-NAME>
                                    <TROUBLE-CODE>6581161</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246BA9</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1253305013">A wheel speed sensor with wrong sensor type is mounted on wheel FL</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_2127449424">Within this monitoring, the special sensor information of the specific WSS type is checked against the WSS type configured in SW. Deviation in the result shows that wrong sensor type is mounted in the wheel FL. This also detects if a directional/intelligent sensor is mounted instead of a non-directional/non-intelligent sensor and viceversa.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_2008987478">When a wrong WSS sensor type is mounted on wheel FL. Mounted WSS sensor in the vehicle and the sensor configured in the SW are different.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246BAA" OID="9469bd3b-b522-4182-9894-c61c9e5b4df7">
