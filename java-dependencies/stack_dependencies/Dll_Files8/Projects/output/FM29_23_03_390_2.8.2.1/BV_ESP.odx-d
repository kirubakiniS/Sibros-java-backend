                                            <SD SI="Cause_of_Failure" TI="TI_455499713">CRC fail bit for Trimming data is set during cyclic operation</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
