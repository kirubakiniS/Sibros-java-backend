                                <DTC ID="DTCC2474A0" OID="5cd6b928-d21b-47cb-8b09-dacdea808299">
                                    <SHORT-NAME>DTCC2474A0</SHORT-NAME>
                                    <TROUBLE-CODE>6583456</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2474A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2103763481">Voltage monitor of microcontroller has detected a failure of the microcontroller supply voltage.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_708639003">In case the core voltage is out of range (over/under-voltage), the Core Voltage Monitor issues a reset. Once the core voltage is in range again, a failure will be reported.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1365604810">Core voltage is out of range.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2489A0" OID="75a5ffbc-5026-4130-8edd-14e82880b1f1">
                                    <SHORT-NAME>DTCC2489A0</SHORT-NAME>
                                    <TROUBLE-CODE>6588832</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2489A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_840175728">HWBIST detected a error.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1089258085">Logic Build-In Self-Test (LBIST) and Memory Build-In Self-Test (MBIST) are performed during microcontroller start up by HW and the corresponding test results are evaluated by SW.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1143876895">Failure detected in non-redundant safety measures (e.g. compare units) by LBIST or memory failure detected in Global RAM, Local RAM or Peripheral RAMs by MBIST (uncorrectable ECC fault or limit of ECC correctable bit faults exceeded).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC248AA0" OID="6b2a5658-c027-4901-aa82-6bfea11133b1">
                                    <SHORT-NAME>DTCC248AA0</SHORT-NAME>
                                    <TROUBLE-CODE>6589088</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C248AA0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1630387913">RAM Failure</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1933703433">RAM is protected by Error Correction Code (ECC). In addition there are three different tests running:1. Pattern Test: Differentiation between correctable and uncorrectable faults2. Data-Path Test: Detection of coupling faults between neighboring RAM cells3. Address-Path Test: Detection of addressing faults</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_2057828884">1. Uncorrectable RAM ECC fault2. Limit of RAM ECC correctable bit faults exceeded3. Coupling between neighbouring RAM cells4. RAM addressing faults</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2490A0" OID="10789942-69cb-40b5-b2f5-b47c7a22be33">
                                    <SHORT-NAME>DTCC2490A0</SHORT-NAME>
                                    <TROUBLE-CODE>6590624</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2490A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_144518772">Flash failure detected (incorrect checksum, single error overflow)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_657461718">Flash is protected by Error Correction Code. In addition there is a checksum calculated and compared with an offline calculated checksum (execution within init task as well as cyclic task).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1101942755">Uncorrectable Flash ECC fault, Limit of Flash ECC correctable bit faults exceeded or Flash checksum verification failed.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2485A0" OID="186b5791-c72a-42b7-9e1b-81f70d7ae02e">
                                    <SHORT-NAME>DTCC2485A0</SHORT-NAME>
                                    <TROUBLE-CODE>6587808</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2485A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_396301654">Microcontroller safety logic has detected a failure.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_604927021">If a microcontroller failure is detected the ErrorPin is set by HW only reaction (no SW action) and an exception is issued.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_324768569">Microcontroller safety logic detected an error (e.g. Flash/RAM ECC uncorrectable fault)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2485A1" OID="bf37df4f-0722-4421-b1fe-8acc9ff9cd6a">
                                    <SHORT-NAME>DTCC2485A1</SHORT-NAME>
                                    <TROUBLE-CODE>6587809</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2485A1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_108910511">Startup safety test detected a failure of uC safety logic.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1482350947">During start up the safety logic (e.g. Flash/RAM ECC) of the microcontroller is tested. If one of these tests fails RBuCSafetyLogicFault is reported.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
