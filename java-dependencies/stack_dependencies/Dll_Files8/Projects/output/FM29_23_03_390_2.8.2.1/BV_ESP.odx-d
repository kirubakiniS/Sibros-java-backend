                                <DTC ID="DTCC248CA0" OID="d8532da3-eff4-46ab-861e-84828d7a7adb">
                                    <SHORT-NAME>DTCC248CA0</SHORT-NAME>
                                    <TROUBLE-CODE>6589600</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C248CA0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_929654577">U5V is out of range.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1088596397">Monitoring of U5V (internal 5V supply for sensors and communication) out of range bits provided by the ASIC. If U5V is out of range a reset should be issued for the ASIC.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
