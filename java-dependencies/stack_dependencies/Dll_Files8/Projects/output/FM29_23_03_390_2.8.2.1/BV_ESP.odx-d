                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245DA2" OID="913a553d-7082-4a93-b0ea-c3d3a4698b6b">
                                    <SHORT-NAME>DTCC245DA2</SHORT-NAME>
                                    <TROUBLE-CODE>6577570</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245DA2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_815895843">Microcontroller memory/peripheral guard has detected a violation event by an unauthorized busmaster.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1861162624">If a guard violation is detected the information failure is set.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
