                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1416999677">1.) The WSS is not securely mounted. 2.) The WSS signal is disturbed by worn or missing teeth. 3.) The WSS signal is disturbed by dirty encoding wheel.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B0" OID="3df771df-ffae-4fe3-bcdc-8f6b2f529c3d">
                                    <SHORT-NAME>DTCC2471B0</SHORT-NAME>
                                    <TROUBLE-CODE>6582704</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2471B0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_935148891">The failure is set if the wheel acceleration is implausible high, the wheel jerk is implausible high or edges and time information do not match at low speed. The monitoring is able to detect up to four defect wheel speed sensors.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_924944307">1.) The WSS signal is disturbed by worn or missing teeth. 2.)  The WSS signal is disturbed by loose contact. 3.) The WSS signal is disturbed by electronic or mechanical interference.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B1" OID="c5ca5bc1-50b6-46c6-8bd7-f4469b1fbe17">
                                    <SHORT-NAME>DTCC2471B1</SHORT-NAME>
                                    <TROUBLE-CODE>6582705</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2471B1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_288591410">The failure is set if the wheel velocity is higher than a specific threshold %{ 82.23 | m/s | 2 | SspWss_SiS_vMax }%.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_488630561">1.) A wrong sensor type is mounted. 2.) The WSS signal is disturbed by electronic or mechanical interference.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B2" OID="d77a1134-2731-4476-9aaa-4302bb2018d5">
                                    <SHORT-NAME>DTCC2471B2</SHORT-NAME>
                                    <TROUBLE-CODE>6582706</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2471B2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1376446618">The monitoring checks for a lost signal fault and consists of following parts: 1.) drive off low monitoring: The failure is set after a particular wheel speed stays at zero for a minimum time %{ 0.5 | s | 1 |   }% after drive off and afterwards the vehicle velocity increases by a specific threshold %{ 3.4 | m/s | 1 |   }%. The monitoring is able to detect up to two defect wheel speed sensors.2.) drive off high monitoring: The failure is set after a particular wheel speed drops to zero and the vehicle velocity increases by a specific threshold %{ 5 | m/s | 2 | MAX(MAX((SspWss_vDOLO_CheckFailLower*((48/2)/(AnzahlZaehne_VA/Abrollumfang_VA))),SspWss_vDOLO_CheckFailLower),SspWss_v_DOHI_Offset)}%. The monitoring is able to detect up to two defect wheel speed sensors.3.) dynamic monitoring: The failure is set after a particular wheel speed drops to zero and no edges of the encoding wheel are delivered by the sensor.From functional perspective, the monitoring shall not be curable within the same ignition cycle, although in DEM it is configured as curable. This is only implemented like this to be able to use DEM functionality "Sequential failure buffer" to synchronize with HSW WSS monitors. The monitor will never reset in the same cycle after a fault is detected without HSW fault detected.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_10085620">1.) The WSS is not correctly mounted, so that no signal is induced in sensor element. 2.) The WSS is dislodged from bracket, so that no signal is induced in sensor element.  3.) The airgap between sensor and encoding wheel is too big to induce sufficient signal in sensor element. 4.) Malfunction of sensor internal logic. 5.) Tone wheel not mounted correctly or demagnetized. 6.) The Input amplifier in ECU is faulty. 7.) The WSS signal is disturbed by loose contact. 8.) The WSS signal is disturbed by open circuit in the WSS line.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B3" OID="4680fc77-1b1e-46e9-8e17-5cbafb0ff1ca">
                                    <SHORT-NAME>DTCC2471B3</SHORT-NAME>
                                    <TROUBLE-CODE>6582707</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2471B3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1837033187">The failure is set if the difference between maximum and minimum wheel speed related to vehicle speed exceeds a calculated threshold. This threshold is depending on vehicle speed and current system mode. A wheel specific fault is set, if the faulty wheel is always the same. 1.) ESP Mode: For vehicle speeds lower than a specific value %{ 5.56 | m/s | 2 | SspWss_MonVdiff_v_Switch5 }% the failure threshold is an absolute value %{ 1.4 | m/s | 2 | SspWss_MonVdiff_vDiff_Lo5/SspWss_MonVdiff_v_SREF_perc }%. Above this vehicle speed the failure threshold is a relative value %{ 5 | % | 2 | SspWss_MonVdiff_vDiff_Lo5 }%. 2.) ABS and backup-EBD Mode: For vehicle speeds lower than a specific value %{ 27.8 | m/s | 2 | SspWss_MonVdiff_v_Switch6 }% the failure threshold is an absolute value %{ 1.7 | m/s | 2 | SspWss_MonVdiff_vDiff_Lo6/SspWss_MonVdiff_v_SREF_perc }%. Above this vehicle speed the failure threshold is a relative value %{ 6 | % | 2 | SspWss_MonVdiff_vDiff_Lo6 }%.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1279227902">1.) Wrong tyre size. 2.) Wrong pulse wheel toothcount. 3.) The WSS is not correctly mounted, so that no signal is induced in sensor element. 4.) The WSS is dislodged from bracket, so that no signal is induced in sensor element.  5.) The airgap between sensor and encoding wheel is too big to induce sufficient signal in sensor element. 6.) Malfunction of sensor internal logic. 7.) Tone wheel not mounted correctly or demagnetized. 8.) The WSS signal is disturbed by loose contact. 9.) The WSS signal is disturbed by open circuit in the WSS line.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B4" OID="a41d0115-7d18-424e-845a-fb693f3b4622">
                                    <SHORT-NAME>DTCC2471B4</SHORT-NAME>
                                    <TROUBLE-CODE>6582708</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2471B4</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_508322280">The failure is set after 10 wheel rotations if a gap of the raw wheel speed sensor signal cyclically occurs.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1416999677">1.) The WSS is not securely mounted. 2.) The WSS signal is disturbed by worn or missing teeth. 3.) The WSS signal is disturbed by dirty encoding wheel.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2471B5" OID="f09f5cb6-5292-4ad6-bc81-b06bd191ec5b">
