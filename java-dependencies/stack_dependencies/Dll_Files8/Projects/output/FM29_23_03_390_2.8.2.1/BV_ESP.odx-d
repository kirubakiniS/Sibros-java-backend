                                    <TROUBLE-CODE>6589858</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C248DA2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_878901524">Operating System error (e.g. task overrun, invalid parameters for OS API)</TEXT>
                                    <SDGS>
