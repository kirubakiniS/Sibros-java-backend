                                <DTC ID="DTCC245AA0" OID="86bfff6c-d9ef-4028-a23d-b239cb20cf94">
                                    <SHORT-NAME>DTCC245AA0</SHORT-NAME>
                                    <TROUBLE-CODE>6576800</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1303181889">SAS Calibration Error</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_445088133">The failure is set if during Steering Angle Sensor Calibration the steering angle sensor is not responding within a specific time span.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_638376225">1.) The SAS is not responding because of defective steering angle sensor.2.) The SAS is not responding because of because of CAN/Flexray failure.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA1" OID="1db67b34-66ab-42b4-b9c6-f6f10835ad19">
                                    <SHORT-NAME>DTCC245AA1</SHORT-NAME>
                                    <TROUBLE-CODE>6576801</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1359623861">The failure is set if SAS sensor transmits more than 3 or less than 1 message(s) via bus communication refered to a cycle time of 20 ms.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_364990139">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of CAN/Flexray failure.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA2" OID="e8699a6a-5a3d-452c-a932-b8a0bb2df6c5">
                                    <SHORT-NAME>DTCC245AA2</SHORT-NAME>
                                    <TROUBLE-CODE>6576802</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_2098507098">The failure is set1.) if the steering angle sensor Class 3 is not initialized or calibrated or if the center of SAS Class 1 was not found AND2.) a.) if in init phase the vehicle speed is higher than a minimum threshold %{ 0 | m/s | 2 | vFzRefXFAMin # }% and the center was not found until a specific time %{ 0 | s | 2 | XFAFailureTimeDelay # }% OR b.) if in init phase the vehicle speed is higher than a maximum threshold %{ 0 | m/s | 2 | vFzRefXFAMax # }% ORc.) if SAS signal was available before in the ignition cycle and the vehicle speed is higher than threshold %{ 0 | m/s | 2 | vFzRefXFAInitLoss # }%. The failure will be reset as soon as the SAS Class 3 is initialized and calibrated or for SAS Class 1 the center is found.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1956701794">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of wrong sensor mounting.3.) The SAS is not calibrated yet (Class 2&amp;3).4.) The SAS signal is faulty because of wheel speed sensors interchange (Class 1: learning condition not fulfilled).5.) The SAS signal is invalid because of failure in YRS signal (Class 1: learning condition not fulfilled).6.) The SAS signal is faulty because of geometrical failure at steering mechanic (Class 1: learning condition not fulfilled).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA3" OID="094c8a2a-948d-4d42-9c38-197e4533a701">
                                    <SHORT-NAME>DTCC245AA3</SHORT-NAME>
                                    <TROUBLE-CODE>6576803</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_578837333">OBD failures that will be set after second occurence</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1040538550">The monitoring checks for a physically plausible steering angle signal range in case of right steering. The failure is set after the received raw sensor signal is higher than a specific threshold %{ 810 | deg | 0 | LwAnschlMax+LwAnschlZuschlag # }%. This threshold is the sum of the maximum, physical steering wheel turn from zero-position to steering stop in the vehicle and an additional robustness tolerance value.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_627851633">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of wrong sensor mounting.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA4" OID="301fbb06-27c1-49a0-938f-4a960723d5bd">
                                    <SHORT-NAME>DTCC245AA4</SHORT-NAME>
                                    <TROUBLE-CODE>6576804</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA4</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_578837333">OBD failures that will be set after second occurence</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_435484018">The monitoring checks for a physically plausible steering angle signal range in case of left steering. The failure is set after the received raw sensor signal is lower than minus a specific threshold %{ 810 | deg | 0 | LwAnschlMax+LwAnschlZuschlag # }%. This threshold is the sum of the maximum, physical steering wheel turn from zero-position to steering stop in the vehicle and an additional robustness tolerance value.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_627851633">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of wrong sensor mounting.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA5" OID="afe0316f-a623-4a45-b37d-d7e2ae0c10fe">
                                    <SHORT-NAME>DTCC245AA5</SHORT-NAME>
                                    <TROUBLE-CODE>6576805</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA5</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_287518737">The monitoring checks for a physically plausible steering angle signal and consists of following parts:1.) Sas gradient monitoring: The failure is set in three different situations:a.) if the signal gradient (steering angle velocity) from one task cycle to another is higher than a specific threshold %{ 60 | deg | 0 | LwInGradMax # }% for defined number of SAS Messages %{ 2 | | 0 | msmc_LwsDifMc }%. b.) if the signal gradient (steering angle velocity) from one task cycle to another is higher than specific threshold %{ 90 | deg | 0 | LwInGradMax2 # }% for more than a defined number of SAS messages %{ 3 | | 0 | msmc_LwsDifMcOg }%.c.) if the steering angle signal acceleration is higher than a specific threshold %{ 30 | deg | 0 | LwInGradDiffMax # }%.2.) Sas plausibility versus yaw rate: The failure is set if the difference between measured steering angle and model calculated value based on yaw rate signal is higher than a velocity dependent threshold. The bigger the velocity, the lower the threshold. The threshold is between two values %{ 10 | deg | 0 | }% %{ 100 | deg | 0 | }%. The deviation is recognized through three possible recognition paths evaluating stable driving conditions. This is to prevent a fault recognition due to unstable driving. The sensor - yaw rate sensor or steering angle sensor - which is showing the largest deviation to the reference yaw rate is marked as faulty.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_546039172">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of wrong sensor mounting.3.) The SAS signal is faulty because of wheel speed sensors interchange (Class 1: learning condition not fulfilled).4.) The SAS signal is invalid because of failure in YRS signal (Class 1: learning condition not fulfilled).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA6" OID="c3531d68-0293-4516-9dd1-40991cc3731e">
                                    <SHORT-NAME>DTCC245AA6</SHORT-NAME>
                                    <TROUBLE-CODE>6576806</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1717201558">The failure is set if the long time filtered steering angle value called steering angle offset is higher than a specific threshold %{ 15 | deg | 0 | P_LtcSasSensorOffset_Max }%. Calculation of the steering angle offset is done in this way: During normal driving for a long time a symmetrical driving situation is supposed. In this case the mean driving direction is straight ahead and the long time filtered steering angle should be zero. The deviation from the zero position is the steering angle offset. The offset is stored in the EEPROM over the power cycle.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_679796342">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of wrong sensor mounting.3.) The SAS is faulty calibrated (end of line).4.) The SAS signal is faulty because of wheel speed sensors interchange (Class 1: learning condition not fulfilled).5.) The SAS signal is invalid because of failure in YRS signal.6.) The SAS signal is faulty because of geometrical failure at steering mechanic (Class 1: learning condition not fulfilled).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2456AB" OID="74a26908-016a-4ed4-a972-e17d3898b2a8">
                                    <SHORT-NAME>DTCC2456AB</SHORT-NAME>
                                    <TROUBLE-CODE>6575787</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2456AB</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1722637258">This monitoring detects a wrong sign of steering angle signal. The yaw rate calculated from steering angle, the measured yaw rate and the yaw rates calculated from the wheel speed sensors are compared. If the measured yaw rate and the wheel speeds based yaw rate models fit to the model yaw rate from steering angle, positive integrals (Ivorwaerts, IvGiVrFA and IvGiVrRA) are calculated, but if the negative values fits, the integrals will become negative. A fault is determined if the integral values are negative and smaller than %{ 0.52 | rad | 2 | IvorwaertsSw1# }% and forward driving is recognized either by reaching a speed threshold close to maximum possible reverse speed %{ 19.5 | m/s | 1 | P_vFzRefVorwSw # }% or by intelligent wheel speed sensors direction information. This fault can also be determined only by wheel speed based integrals IvGiVrRA and IvGiVrFA &lt; %{ 1.57 | rad | 2 | IvorwaertsSw2# }% indipendent of the driving direction. It requires a release check in the following ignition cycle to prevent system release when the fault is still present.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_735711812">Wrong assembly position of the steering angle sensor or swapped wheel speed sensors.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC245AA7" OID="2199b091-3142-4c05-b864-243e11936b42">
                                    <SHORT-NAME>DTCC245AA7</SHORT-NAME>
                                    <TROUBLE-CODE>6576807</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C245AA7</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1088234580">The failure is set if the change of steering angle signal is less than a specific value %{ 5 | deg | 0 | P_DifLwMinMax # }% but both right and left cornering (since last vehicle stand-still situation) was detected.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_364990139">1.) The SAS signal is faulty because of defective steering angle sensor.2.) The SAS signal is faulty because of CAN/Flexray failure.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2451D2" OID="1e6bab32-5ae0-4c8d-97d9-74756d159132">
                                    <SHORT-NAME>DTCC2451D2</SHORT-NAME>
                                    <TROUBLE-CODE>6574546</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451D2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_853849318">The left APB motor stalls during locking.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_205811128">The MGU current is checked permanently. A too high temperature must be avoided to protect the power stage. With a temperature model the heat up and cool down behaviour is estimated. If the estimated temperature is beyond a critical threshold, then a failure message is generated. During a motor stall the temperature increases rapidely, that means, that a MGU is switched off after a short time.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1656175963">mechanical clamping of MGU or spindle</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2451D3" OID="f7d3fb35-0d55-4690-bb0b-bc493612d117">
                                    <SHORT-NAME>DTCC2451D3</SHORT-NAME>
                                    <TROUBLE-CODE>6574547</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451D3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_12060394">The right APB motor stalls during locking.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_205811128">The MGU current is checked permanently. A too high temperature must be avoided to protect the power stage. With a temperature model the heat up and cool down behaviour is estimated. If the estimated temperature is beyond a critical threshold, then a failure message is generated. During a motor stall the temperature increases rapidely, that means, that a MGU is switched off after a short time.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1656175963">mechanical clamping of MGU or spindle</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU197EC2" OID="8138e55e-c115-4033-abb0-718d7c8498d6">
                                    <SHORT-NAME>DTCU197EC2</SHORT-NAME>
                                    <TROUBLE-CODE>14253762</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U197EC2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_319829064">replacement fault for NET overvoltage situation</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_645523489">This is possible using storage conditions(formerly called Situation filter)</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1342580150">NET-Voltage replacement failure if there is a communication failure present during an overvoltage situation.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU197EC3" OID="dcffa921-9e62-43ed-a71e-254292c45510">
                                    <SHORT-NAME>DTCU197EC3</SHORT-NAME>
                                    <TROUBLE-CODE>14253763</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U197EC3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2099227918">replacement fault for NET undervoltage situation</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_32727340">This is possible using storage conditions(formerly called Situation filter</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1051089469">NET-Voltage replacement failure if there is a communication failure present during an undervoltage situation.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                            </DTCS>
                        </DTC-DOP>
                    </DTC-DOPS>
