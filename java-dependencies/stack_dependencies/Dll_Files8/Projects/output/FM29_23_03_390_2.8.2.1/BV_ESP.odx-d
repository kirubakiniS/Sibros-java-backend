                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_672436357">Status of the DMA TU buffer is monitored to detect overflow due to too high frequency on WSS_FR.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1388854558">DMA buffer overflow (when all timestamps for every edge, could not be logged in memory).This may be due to defect of the WSS sensor(WSS_FR) or internal hardware defect.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246CA9" OID="900cf5ea-7787-409e-8e89-cf60c1fd4313">
                                    <SHORT-NAME>DTCC246CA9</SHORT-NAME>
                                    <TROUBLE-CODE>6581417</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246CA9</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_631741711">A wheel speed sensor with wrong sensor type is mounted on wheel FR</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_285586415">Within this monitoring, the special sensor information of the specific WSS type is checked against the WSS type configured in SW. Deviation in the result shows that wrong sensor type is mounted in the wheel FR. This also detects if a directional/intelligent sensor is mounted instead of a non-directional/non-intelligent sensor and viceversa.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_662878812">When a wrong WSS sensor type is mounted on wheel FR. Mounted WSS sensor in the vehicle and the sensor configured in the SW are different.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246CAA" OID="febfa404-d3d7-4f08-961f-10b7db0c0591">
