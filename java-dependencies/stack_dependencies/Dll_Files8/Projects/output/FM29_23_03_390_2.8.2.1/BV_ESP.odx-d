                                <DTC ID="DTCC2451CC" OID="4ebe4e35-43d2-4c8c-8697-b394eaf8c77f">
                                    <SHORT-NAME>DTCC2451CC</SHORT-NAME>
                                    <TROUBLE-CODE>6574540</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451CC</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1020950735">Left ECU motor voltage has the wrong polarity.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1845209503">If a request for left MGU activation is detected, then the monitoring checks the motor current. Failure is set, if if it falls below a threshold for a defined duration.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_607195284">left APB motor line interruption</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
