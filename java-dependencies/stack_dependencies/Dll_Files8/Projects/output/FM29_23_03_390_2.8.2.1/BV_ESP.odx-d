                                    <DISPLAY-TROUBLE-CODE>C2471A6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1909817130">Monitoring of wheel direction differences. Faulty wheel RR</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
