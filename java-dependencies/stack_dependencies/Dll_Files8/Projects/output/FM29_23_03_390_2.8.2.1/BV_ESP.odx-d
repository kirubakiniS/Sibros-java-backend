                                                <VT TI="TI_929545490">0xA5FF Coding Data String Validation</VT>
                                            </COMPU-CONST>
                                        </COMPU-SCALE>
                                        <COMPU-SCALE>
                                            <SHORT-LABEL TI="TI_1779576482">APB Actuator State</SHORT-LABEL>
                                            <LOWER-LIMIT>2384</LOWER-LIMIT>
                                            <UPPER-LIMIT>2384</UPPER-LIMIT>
