                                    <SHORT-NAME>DTCC2452A6</SHORT-NAME>
                                    <TROUBLE-CODE>6574758</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2452A6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1126977953">Pressure sensor MC1 Offset is too high</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_691591169">The fault is set if the master cylinder pressure sensor offset monitoring detects a positive or negative offset which is out of the specified signal range ({%default: 15bar(P_pOffsetMax_DS8_1)%}).The zero bar pressure level is at 0.3V and the conversion factor between voltage/pressure is 9.8mV/bar.The offset value is written to EEPROM after 3min and after 15min.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1869543235">The pressure sensor for the master brake cylinder is mechanically or electrically defective.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
