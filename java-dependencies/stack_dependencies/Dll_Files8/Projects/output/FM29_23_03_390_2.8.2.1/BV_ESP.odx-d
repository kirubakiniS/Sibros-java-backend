                                <DTC ID="DTCC2461A5" OID="9c9f4b2d-e8c2-4c56-b40b-fe1f6734a2ef">
                                    <SHORT-NAME>DTCC2461A5</SHORT-NAME>
                                    <TROUBLE-CODE>6578597</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A5</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1918329813">APB Asic internal voltage bits stuck</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1120414286">Control of the internal voltage monitoring of the APB ASIC. If overvoltage, undervoltage or groundloss is detected in the APB Asic the failure counter get raised. Continuously activation in 5ms task. The monitoring threshold is 30ms.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1565922529">An internal voltage monitoring raised a failure. 1. Overvoltage, indicated by Vint_O_fail_SPI. 2. Undervoltage, indicated by Vint_U_fail_SPI. 3. Ground pins are not shorted internal in the APB ASIC, indicated by GNDloss_fail_SPI.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A6" OID="3d404173-28e3-41e7-9087-61bd827edc2f">
                                    <SHORT-NAME>DTCC2461A6</SHORT-NAME>
                                    <TROUBLE-CODE>6578598</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_264645139">Init test for APB Asic internal oscillator monitoring failed.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1672160780">The oscillator monitoring init test detect a malfunction or a stuck bit inside the APB Asic. Triggers a failure at oscillator 1 and controls that the APB Asic performs as anticipated.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_34942434">The oscillator monitoring init test detect a malfunction or a stuck OSC_fail_SPI bit. The oscillator monitoring can be tested with a dedicated SPI command SPI_OSCtest = "1". The test will generate a stucked CLK1 and the monitoring has to switch the logic clock to CLK2. The failure has to be shown by OSC_fail_SPI.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A7" OID="7aaf2c12-95c8-4497-801e-f72d39807625">
                                    <SHORT-NAME>DTCC2461A7</SHORT-NAME>
                                    <TROUBLE-CODE>6578599</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A7</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1537109565">APB ASIC reset was failed.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_868915567">Software triggers an APB ASIC reset at init task. If a APB ASIC reset(Initial Start Up) test failed during the reset, or time out reached, or SPI communication with APB ASIC failed, this failure word will be set.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_864690854">APB ASIC defect. APB ASIC reset (Initial Start Up) test failed or time out, or SPI communication with APB ASIC failed.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
