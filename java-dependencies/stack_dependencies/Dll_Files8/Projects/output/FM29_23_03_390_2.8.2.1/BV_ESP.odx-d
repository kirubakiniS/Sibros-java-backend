                                <DTC ID="DTCC246DA7" OID="da1b3152-65e7-48e9-b0d4-f4d39e81634f">
                                    <SHORT-NAME>DTCC246DA7</SHORT-NAME>
                                    <TROUBLE-CODE>6581671</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246DA7</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1799670174">The air gap limit bit of the ASIC is monitored and deviations in the bit are notified.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_932110985">Intelligent sensor signalled an incorrect airgap between transmitter wheel(Rear Right) and sensor itself.Magnetic flux density measured by sensor is incorrect.This typically points to misassembly or wheel vibrations on WSS_RR.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246DA8" OID="fb835e1d-3e1e-446c-8e76-00bf577bc99b">
                                    <SHORT-NAME>DTCC246DA8</SHORT-NAME>
                                    <TROUBLE-CODE>6581672</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246DA8</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2137440368">Error passiv failure on Can 0</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_2134849448">Status of the DMA TU buffer is monitored to detect overflow due to too high frequency on WSS_RR.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1658208850">DMA buffer overflow (when all timestamps for every edge, could not be logged in memory).This may be due to defect of the WSS sensor(WSS_RR) or internal hardware defect.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC246DA9" OID="f1d22805-fc28-49fd-8e46-456868064145">
                                    <SHORT-NAME>DTCC246DA9</SHORT-NAME>
                                    <TROUBLE-CODE>6581673</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C246DA9</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1327675719">A wheel speed sensor with wrong sensor type is mounted on wheel RR</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1900950576">Within this monitoring, the special sensor information of the specific WSS type is checked against the WSS type configured in SW. Deviation in the result shows that wrong sensor type is mounted in the wheel RR. This also detects if a directional/intelligent sensor is mounted instead of a non-directional/non-intelligent sensor and viceversa.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_301398122">When a wrong WSS sensor type is mounted on wheel RR. Mounted WSS sensor in the vehicle and the sensor configured in the SW are different.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
