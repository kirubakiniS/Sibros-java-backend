                                <DTC ID="DTCC2451A0" OID="ed6abb4f-bb28-46a6-9b6e-c19f7a4fcab8">
                                    <SHORT-NAME>DTCC2451A0</SHORT-NAME>
                                    <TROUBLE-CODE>6574496</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2451A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1759715470">Shadow Memory cell defect</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1871951220">the write result is checked at the end of EEPROM write procedure; an invalid cell results to a read back error after writing</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_701928046">EEPROM cell defect</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A0" OID="74d86703-1ebf-4a8b-995b-4ff8d3d73881">
                                    <SHORT-NAME>DTCC2461A0</SHORT-NAME>
                                    <TROUBLE-CODE>6578592</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1224861600">APB ASIC is in wrong SPI mode.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_202361622">APB ASIC is by default at STM SPI mode after Power on reset. The target SPI mode is Bosch SPI mode. In init task, a SPI mode change sequence is done before any SPI communication. And software checks whether the SPI mode is the target after the SPI mode change sequence. If the SPI mode is not the target, this failure will be set.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1524616830">Set fault, if APB ASIC SPI Mode Change is not successfully finished.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A1" OID="65e8d407-0399-472e-8851-5a41638ba52d">
                                    <SHORT-NAME>DTCC2461A1</SHORT-NAME>
                                    <TROUBLE-CODE>6578593</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_771656768">ASIC Init test failed during init task</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1312186405">uC sends some failure test frames (address error, parity error, clock error) and evaluate the responses. The tests pass if the APB ASIC could detect the failure and set corresponding failure flags.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1944823783">Defect in the APB ASIC, the SPI failure detection function in the ASIC does not work.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A2" OID="c77167da-bfe2-4f00-a469-1b843067a9c8">
                                    <SHORT-NAME>DTCC2461A2</SHORT-NAME>
                                    <TROUBLE-CODE>6578594</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_911095839">SPI transfer to APB ASIC was failed (error frame, wrong address. timeout, CSIH error)</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_497787993">Investigate the receive data of the APB ASIC for parity-, address- or clock-failures. Time out failure is also included in this failure word.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1081593392">SPi failure 1. Wrong data send to/from Asic 2. Defect SPI line 3. Defect Asic</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2461A3" OID="1400dacf-5e42-44bf-b372-faf7217fce71">
                                    <SHORT-NAME>DTCC2461A3</SHORT-NAME>
                                    <TROUBLE-CODE>6578595</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2461A3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1407502792">CRC fail bit for Trimming Data in OTP area is set during Init</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_34438333">If CRC_fail_SPI bit is set, the bit is read in init and failure is set immediately</SD>
