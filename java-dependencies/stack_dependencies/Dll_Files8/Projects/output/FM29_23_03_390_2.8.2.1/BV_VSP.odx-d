                                <DTC ID="DTCU200216" IS-TEMPORARY="false" OID="3d126865-db58-416f-b6bb-32494733abbb">
                                    <SHORT-NAME>DTCU200216</SHORT-NAME>
                                    <TROUBLE-CODE>14680598</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U200216</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_691616701">Battery Voltage Failure  -  voltage is below threshold</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_292577194">tbd</SD>
                                            <SD SI="Repair_Action" TI="TI_1825007423">Voltage returns to 9-16 V. If it returns to normal, the fault can be restored to a historical fault during this power on cycle</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1544496510">Ignition ON or ECU is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1950086098">1 sec</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_338561048">Main power supply voltage is lower than 8.3V and lasts for 10s</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1825007423">Voltage returns to 9-16 V. If it returns to normal, the fault can be restored to a historical fault during this power on cycle</SD>
                                            <SD SI="Limp_home_Action" TI="TI_641168598">Record DTC; function degradation</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_225691098">The Aging counter should be 40dec and stored in the NVM when a fault first occurs. If an error-free detection cycle without a "test failed" in previous and current driving cycle, the Aging counter should be decremented by 1.</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1586113927">Voltage is too low, which is lower than 8.3 V for 10 s</SD>
                                            <SD SI="Possible_Impact" TI="TI_867162237">Record DTC. The fault warning lamp characterizing the recoverable fault will be lighten.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
