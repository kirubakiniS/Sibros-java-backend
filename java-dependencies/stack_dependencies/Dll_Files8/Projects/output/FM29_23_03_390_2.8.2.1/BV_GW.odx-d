                    <STRUCTURES>
                        <STRUCTURE ID="ST__Update_CS_Key">
                            <SHORT-NAME>ST_Update_CS_Key</SHORT-NAME>
                            <LONG-NAME TI="TI_1769080631">Structure Update CS Key</LONG-NAME>
                            <PARAMS>
                                <PARAM SEMANTIC="ID" xsi:type="VALUE">
                                    <SHORT-NAME>Key_Index</SHORT-NAME>
                                    <LONG-NAME TI="TI_105135597">Key Index</LONG-NAME>
                                    <DESC TI="TI_618707423">
                                        <p>0x00:UDS 0x27 Level 1 key</p>
                                        <p>0x01:UDS 0x27 Level 3 key</p>
                                        <p>0x03:Security log AES-CBC-128 key</p>
                                        <p>0x04:Security log signuate key</p>
                                        <p>0x05:Tester Authentication key</p>
                                        <p>0x06:T-Box Authentication key</p>
                                        <p>0x07:FvM AES-128-MAC key</p>
                                        <p>0x08:Key Update AES-128 key</p>
                                        <p>0x09:Key Update Signature key</p>
                                        <p>0x0A-0xFF:Reserved</p>
                                        <p/>
                                    </DESC>
                                    <BYTE-POSITION>0</BYTE-POSITION>
                                    <BIT-POSITION>0</BIT-POSITION>
                                    <DOP-SNREF SHORT-NAME="DOP_Update_CS_Key_Index"/>
                                </PARAM>
                                <PARAM SEMANTIC="ID" xsi:type="VALUE">
                                    <SHORT-NAME>Keys</SHORT-NAME>
                                    <LONG-NAME TI="TI_242517168">Keys</LONG-NAME>
                                    <DESC TI="TI_581027847">
                                        <p>Key Raw</p>
                                    </DESC>
                                    <BYTE-POSITION>1</BYTE-POSITION>
                                    <BIT-POSITION>0</BIT-POSITION>
                                    <DOP-SNREF SHORT-NAME="DOP_Update_CS_Keys"/>
                                </PARAM>
                            </PARAMS>
                        </STRUCTURE>
