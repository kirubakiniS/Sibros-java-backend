                                <DTC ID="DTCP1A3B19" OID="39e6f57b-8ef2-4140-93e1-96da2864f0ec">
                                    <SHORT-NAME>DTCP1A3B19</SHORT-NAME>
                                    <TROUBLE-CODE>1719065</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P1A3B19</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_959026835">Outside ambient temperature sensor fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_1997085970">Replace the sensor or Check the wiring harness</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1315105257">Ignition ON or ECC is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_603488216">100ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1101056011">The temperature of the external temperature sensor exceeds the range of -40℃~80℃ or exceeds the temperature range marked by the sensor RT table for 2s</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_327185186">The temperature of the temperature sensor outside the vehicle returned to the range of -40℃~80℃, and returned to the temperature range marked by RT table, lasting for 2s</SD>
                                            <SD SI="Limp_home_Action" TI="TI_240786095">1.Record DTC;
2.Set to the default value of 25 degrees
3. The effective position of ambient temperature outside the bus is invalid
4, CAN bus output temperature is -48℃;</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1121502405">40 times driving cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_414876642">1. The sensor is damaged or the wiring harness is open;
2. The sensor or cable harness is short-circuited.</SD>
                                            <SD SI="Possible_Impact" TI="TI_899607347">Affect the compressor speed regulation strategy, affect the refrigeration effect, the instrument shows that the ambient temperature is constant 25 degrees</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCP1A3B1A" OID="8f95f4ab-770c-43e9-8f3b-94e86b81b610">
                                    <SHORT-NAME>DTCP1A3B1A</SHORT-NAME>
                                    <TROUBLE-CODE>1719066</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P1A3B1A</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1078262782">The car indoor temperature sensor fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_1997085970">Replace the sensor or Check the wiring harness</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1315105257">Ignition ON or ECC is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_603488216">100ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1191597498">The temperature of the indoor temperature sensor exceeds the range of -40℃~80℃ or exceeds the temperature range marked by the sensor RT table for 2s</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_922502644">The temperature of the indoor sensor outside the vehicle returned to the range of -40℃~80℃, and returned to the temperature range marked by RT table, lasting for 2s</SD>
                                            <SD SI="Limp_home_Action" TI="TI_606968305">1. Send the fault code;
2. Set as HMI temperature setting value;
3, CAN bus car temperature transmission -48℃;</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1121502405">40 times driving cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_414876642">1. The sensor is damaged or the wiring harness is open;
2. The sensor or cable harness is short-circuited.</SD>
                                            <SD SI="Possible_Impact" TI="TI_147569665">The compressor speed regulation affects the cooling effect</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCP1A3B1B" OID="0f20687b-473e-4b6e-83b6-da2f25391a17">
                                    <SHORT-NAME>DTCP1A3B1B</SHORT-NAME>
                                    <TROUBLE-CODE>1719067</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P1A3B1B</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_102682275">The evaporator temperature sensor fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_1997085970">Replace the sensor or Check the wiring harness</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1315105257">Ignition ON or ECC is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_603488216">100ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_495505492">The temperature of the EVAP temperature sensor exceeds the range of -40℃~80℃ or exceeds the temperature range marked by the sensor RT table for 2s</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1570966060">The temperature of the EVAP sensor outside the vehicle returned to the range of -40℃~80℃, and returned to the temperature range marked by RT table, lasting for 2s</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1708853564">1. Send the fault code;
2. The passenger cabin refrigeration compressor does not take evaporation temperature as the control target, but low pressure as the control target;
3. The passenger cabin refrigeration does not take evaporation temperature as the protection target, but the system evaporation pressure as the protection item;</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1121502405">40 times driving cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_414876642">1. The sensor is damaged or the wiring harness is open;
2. The sensor or cable harness is short-circuited.</SD>
                                            <SD SI="Possible_Impact" TI="TI_147569665">The compressor speed regulation affects the cooling effect</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
