                                <DTC ID="DTCP1A3B17" OID="29e1bebf-4491-4ec7-b0b3-603f50d4c94a">
                                    <SHORT-NAME>DTCP1A3B17</SHORT-NAME>
                                    <TROUBLE-CODE>1719063</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P1A3B17</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_506015764">ECC power supply over voltage fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_176649986">Check the battery power supply voltage or replace the ECC controller</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1315105257">Ignition ON or ECC is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_603488216">100ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1383200844">Voltage is higher than 16V for 1s</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248045926">voltage is lower than 16V for 1s</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1843744733">Record DTC;
Close the external control unit</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1121502405">40 times driving cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1416916916">The external input voltage is too high, or the ECC detects circuit faults</SD>
                                            <SD SI="Possible_Impact" TI="TI_486808568">ECC abnormal operation</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCP1A3B18" OID="4e0a8669-434a-4b29-ad6c-4c4798f42215">
                                    <SHORT-NAME>DTCP1A3B18</SHORT-NAME>
                                    <TROUBLE-CODE>1719064</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P1A3B18</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1368027540">ECC power supply under voltage fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_176649986">Check the battery power supply voltage or replace the ECC controller</SD>
