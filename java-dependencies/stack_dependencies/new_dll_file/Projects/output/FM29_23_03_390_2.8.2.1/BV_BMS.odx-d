                            <DTCS>
                                <DTC ID="DTCU200216_EXAMPLE" OID="4687248a-dde8-4cb0-b691-0b107c8668b8">
                                    <SHORT-NAME>DTCU200216</SHORT-NAME>
                                    <TROUBLE-CODE>14680598</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U200216</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_691616701">Battery Voltage Failure  -  voltage is below threshold</TEXT>
                                    <SDGS>
                                    <SDG SI="EXTRAINFO">
                                    <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                    <SD SI="Repair_Action" TI="TI_186886286">- Ensure stable power supply to ADAS DC module. 
- Voltage returns to 8.5 -16.5 V. (Considering +/- 0.5V tolerance from the normal voltage range 9-16 V) 
-  Reconnect the battery/power supply</SD>
                                    <SD
                                    SI="Monitor_Enable_Conditions" TI="TI_814456116">1. Ignition Status : BCM_PwrMod == IGN ON(0x2)||RUN(0x4)
2. De-bounce timer = 5 sec</SD>
                                    <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                    <SD SI="Monitor_Rate" TI="TI_1950086098">1 sec</SD>
                                    <SD
                                    SI="Failure_Criteria_Test_Result_NOK" TI="TI_99836212">Battery Voltage &lt; 8.5 V and last for 10 sec</SD>
                                    <SD
                                    SI="Pass_Criteria_Test_Result_OK" TI="TI_310753292">Battery Voltage &gt; = 8.5 V for 10 sec</SD>
                                    <SD SI="Limp_home_Action" TI="TI_1058857431">- No output video/signal from SVS/DMS
- ADAS feature that use FCM/MRR/USS  will not be available</SD>
                                    <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                    <SD SI="Cause_of_Failure" TI="TI_999553997">- Voltage is too low, which is lower than 8.5 V for 10 sec 
- Failure in the power supply chain/connection error</SD>
                                    <SD SI="Possible_Impact" TI="TI_512972150">ADAS Feature will not be available</SD>
                                    </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU200317_EXAMPLE" OID="1c891e6d-61a2-42c9-9552-324f8e385aa8">
                                    <SHORT-NAME>DTCU200317</SHORT-NAME>
                                    <TROUBLE-CODE>14680855</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U200317</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1003669451">Battery Voltage Failure  -  voltage is above threshold</TEXT>
                                    <SDGS>
                                    <SDG SI="EXTRAINFO">
                                    <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                    <SD SI="Repair_Action" TI="TI_186886286">- Ensure stable power supply to ADAS DC module. 
- Voltage returns to 8.5 -16.5 V. (Considering +/- 0.5V tolerance from the normal voltage range 9-16 V) 
-  Reconnect the battery/power supply</SD>
                                    <SD
                                    SI="Monitor_Enable_Conditions" TI="TI_814456116">1. Ignition Status : BCM_PwrMod == IGN ON(0x2)||RUN(0x4)
2. De-bounce timer = 5 sec</SD>
                                    <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                    <SD SI="Monitor_Rate" TI="TI_452285021">100 ms</SD>
                                    <SD
                                    SI="Failure_Criteria_Test_Result_NOK" TI="TI_941197551">Battery Voltage &gt; 16.5 V and last for 1 sec</SD>
                                    <SD
                                    SI="Pass_Criteria_Test_Result_OK" TI="TI_1166114298">Battery Voltage &lt; = 8.5 V for 1 sec</SD>
                                    <SD SI="Limp_home_Action" TI="TI_1058857431">- No output video/signal from SVS/DMS
- ADAS feature that use FCM/MRR/USS  will not be available</SD>
                                    <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                    <SD SI="Cause_of_Failure" TI="TI_1930103093">- Voltage is too high, which is more than 16.5 V for 1 sec 
- Failure in the power supply chain/connection error</SD>
                                    <SD SI="Possible_Impact" TI="TI_512972150">ADAS Feature will not be available</SD>
                                    </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU200588_EXAMPLE" OID="e646ae2d-9bbc-4846-a8ce-bc6dbf5f0b00">
                                    <SHORT-NAME>DTCU200588</SHORT-NAME>
                                    <TROUBLE-CODE>14681480</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U200588</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_861493793">Vehicle CAN Bus OFF</TEXT>
                                    <SDGS>
                                    <SDG SI="EXTRAINFO">
                                    <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                    <SD SI="Repair_Action" TI="TI_265398006">(1) Check whether the battery voltage is 9 V~16 V
(2) Reconnect the battery/power supply
(3) Check whether the CAN bus connection is normal
(4) Check the connector or transceiver
(5) Check the network state
(6) Check whether there is an open circuit and a short circuit in the wire harness
(7) Replace module and wire harness</SD>
                                    <SD
                                    SI="Monitor_Enable_Conditions" TI="TI_881224913">1. Local voltage is within normal range (9-16V)
2.  De-bounce timer = 5 sec</SD>
                                    <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                    <SD SI="Monitor_Rate" TI="TI_551444254">10 ms</SD>
                                    <SD
                                    SI="Failure_Criteria_Test_Result_NOK" TI="TI_1787480128">Bus off for more than or equal to 30 ms</SD>
                                    <SD
                                    SI="Pass_Criteria_Test_Result_OK" TI="TI_927612769">The communication bus off returns to normal and valid for 10 ms</SD>
                                    <SD SI="Limp_home_Action" TI="TI_1786086682">- Record DTC; Function degradation
- Rear View Only
- No Dynamic Overlays
- FCM, Radar and USS dependent ADAS feature will not run</SD>
                                    <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                    <SD SI="Cause_of_Failure" TI="TI_672536116">- Signal incompatibility caused by transmission or harness problems
-  Short circuit between CAN_H/CAN_L
-  CAN_H low, CAN_H high, CAN_L low, CAN_L high, open circuit CAN_H and/or CAN_L</SD>
                                    <SD SI="Possible_Impact" TI="TI_512972150">ADAS Feature will not be available</SD>
                                    </SDG>
                                    </SDGS>
                                </DTC>
                            </DTCS>
                        </DTC-DOP>
                    </DTC-DOPS>
