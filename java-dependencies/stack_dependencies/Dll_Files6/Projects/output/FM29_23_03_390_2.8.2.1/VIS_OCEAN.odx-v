                                <DESC TI="TI_681962715">
                                    <p>&lt;ID&gt;99&lt;/ID&gt;</p>
                                    <p>&lt;SHORT_NAME&gt;DoIP&lt;/SHORT_NAME&gt;</p>
                                    <p>&lt;DESCRIPTION&gt;</p>
                                    <p>DoIP OBDII crossover adapter to RJ45 ethernet adapter on local host</p>
                                    <p>Ethernet RX+ on pin 12 (pintype TX on vehicle side of OBD adapter)</p>
                                    <p>Ethernet TX+ on pin  3 (pintype RX on vehicle side of OBD adapter)</p>
                                    <p>Ethernet RX- on pin 13 (pintype LOW on vehicle side of OBD adapter)</p>
                                    <p>Ethernet TX- on pin 11 (pintype MINUS on vehicle side of OBD adapter)</p>
                                    <p>&lt;/DESCRIPTION&gt;</p>
                                </DESC>
                                <PIN-NUMBER>3</PIN-NUMBER>
                            </VEHICLE-CONNECTOR-PIN>
