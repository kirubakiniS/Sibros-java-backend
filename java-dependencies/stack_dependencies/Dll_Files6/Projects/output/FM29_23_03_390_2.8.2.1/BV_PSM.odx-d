                                <DTC ID="DLC.DLC_PSM.BV.BV_PSM.DOP.DD_DTCList.DTC.DTCU186201">
                                    <SHORT-NAME>DTCU186201</SHORT-NAME>
                                    <TROUBLE-CODE>14680577</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U186201</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_758697816">Body CAN Busoff fault</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1112876064">Service_Relevant</SD>
                                            <SD SI="Repair_Action" TI="TI_1553300618">Check CAN bus electrically.</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1618264912">1. Local voltage is within normal range (9-16V)/Ignition ON or ECU is awake
2.  De-bounce timer = 5 sec</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1972879520">1000 ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1294975659">Bus is electrically not within the ranges which are specified in the CAN specification.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1870936716">Bus is electrically in the specified ranges of the CAN specification.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1439032156">All DSCM functions are deactivated except seat adjustment in the manual emergency mode.</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_459463619">10 minutes after CAN bus communication has started again, within specified ranges.</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1621887029">Short circuit, open circuit, malicious ECU on the bus, no termination resistors at the end of the CAN bus wires,</SD>
                                            <SD SI="Possible_Impact" TI="TI_1936168322">No CAN communication available.
DSCM can not be used.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
