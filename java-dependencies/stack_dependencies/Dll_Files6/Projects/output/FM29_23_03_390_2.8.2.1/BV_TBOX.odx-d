                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_418322640">There are any failures in using Key/Certificate to establish communication with the Cloud (during Handshake process).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1405423374">Connection is successful once</SD>
                                            <SD SI="Limp_home_Action" TI="TI_799585561">record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_74645677">Fault has disappeared</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_851271261">cloud connection failure</SD>
                                            <SD SI="Possible_Impact" TI="TI_1495130944">no remote features available</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
