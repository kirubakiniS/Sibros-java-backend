                                    <DISPLAY-TROUBLE-CODE>U179B87</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2109863318">Backup battery overvoltage</TEXT>
                                    <LEVEL>3</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_343654338">Monitor battery voltage and replace or reconnect battery as required</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_79242871">Internal battery charging</SD>
                                            <SD SI="Monitor_Type" TI="TI_122203070">At startup / On Demand, AND every 300ms while charging and every 1h cycle time in normal operation</SD>
                                            <SD SI="Monitor_Rate" TI="TI_646897629">300ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1772550640">Voltage &gt;4V for 3 cycles</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_654353520">Voltage &lt;=4V for at least 3 cycles</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1520883740">Disconnect battery. Stop battery charging. Record DTC; function degradation. The instrument displays the fault</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1974564513">Fault has disappeared + Ignition cycle (40dec)</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1259834488">Battery fault or Tbox fault</SD>
                                            <SD SI="Possible_Impact" TI="TI_49457655">No eCall in case of crash that damages the main supply</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU179E51">
                                    <SHORT-NAME>DTCU179E51</SHORT-NAME>
                                    <TROUBLE-CODE>14130769</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U179E51</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1687710477">mTLS Crypto Algorithm initialization Failure</TEXT>
                                    <LEVEL>2</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_2077897402">Configure mTLS key with fisker tools or at fisker EOL</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_800900248">Battery voltage in normal range (9-16V) 
PwrMod == IGN ON </SD>
                                            <SD SI="Monitor_Type" TI="TI_1077741686">At Start up </SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_128973519">The return value of mTLS Crypto Algorithm initialization failed or unsuccessful. </SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_2029012512">The mTLS Crypto Algorithm initialization is Passed or successful</SD>
                                            <SD SI="Limp_home_Action" TI="TI_799585561">record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_977088622">Since initialization happens at the startup, the Failure will be latched until the same initialization function is called again (i.e. entire ECU power cycle).</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_242511224">mTLS key not configured</SD>
                                            <SD SI="Possible_Impact" TI="TI_1495130944">no remote features available</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU179E46">
                                    <SHORT-NAME>DTCU179E46</SHORT-NAME>
                                    <TROUBLE-CODE>14130758</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U179E46</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1336646429">mTLS Keys corrupted</TEXT>
                                    <LEVEL>2</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_1328831430">configure mTLS key with fisker tools or at fisker EOL, if failure persist, replace module TBOX</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_2129484575">Battery voltage in normal range (9-16V) 
PwrMod == IGN ON
BUS physical status</SD>
                                            <SD SI="Monitor_Type" TI="TI_979930598">AtStart up &amp; key Load</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1146457938">Key Storage into Memory Failed (Example Encryption failed) OR
Key retrieval from Memory Failed (Example  CRC/Checksum/Hash/Decryption failed)</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1111251110"> The ECU is able to read and write the key successfully from it's memory</SD>
                                            <SD SI="Limp_home_Action" TI="TI_799585561">record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1576106747">The Failure will be latched (i.e. Entire ECU power cycle) until valid keys are updated.</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_2115055553">mTLS key not corrupted</SD>
                                            <SD SI="Possible_Impact" TI="TI_1495130944">no remote features available</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
