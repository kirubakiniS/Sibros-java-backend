        <COMPARAMS>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="ECU-COMM"
                ID="ISO_11898_2_DWCAN.CP_Baudrate"
                OID="1c569e78-9cf1-48bb-ab3e-ac1c341c9380" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_Baudrate</SHORT-NAME>
                <LONG-NAME TI="TI_391332638">CP_Baudrate</LONG-NAME>
                <DESC TI="TI_1303566141">
                    <p>Represents the desired baud rate.</p>
                    <p>If the desired baud rate cannot be achieved within the tolerance of the protocol, the interface will remain at the previous baud rate.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>500000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_Baud"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_BitSamplePoint"
                OID="e7b7a73b-691a-40ff-bc12-780d9296aa42" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_BitSamplePoint</SHORT-NAME>
                <LONG-NAME TI="TI_1516905184">CP_BitSamplePoint</LONG-NAME>
                <DESC TI="TI_317308427">
                    <p>This sets the desired bit sample point as a percentage of the bit time.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>80</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT7_0_100_PerCent"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_CanBaudrateRecord"
                OID="e8f9ccd7-dd4b-4b9d-8c27-2becc976d73f" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_CanBaudrateRecord</SHORT-NAME>
                <LONG-NAME TI="TI_1247851519">CP_CanBaudrateRecord</LONG-NAME>
                <DESC TI="TI_632001143">
                    <p>List of baud rates to use during an OBD CAN initialization sequence</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>0007A1200003D090</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_BYTEFIELD_0_48_END_OF_PDU"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="ECU-COMM"
                ID="ISO_11898_2_DWCAN.CP_ListenOnly"
                OID="1b040005-983c-4a70-8c1d-37551c587f9a" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_ListenOnly</SHORT-NAME>
                <LONG-NAME TI="TI_376225324">CP_ListenOnly</LONG-NAME>
                <DESC TI="TI_1039779262">
                    <p>Enable a Listen Only mode on the Com Logical Link</p>
                    <p>This will cause the link to no longer acknowledge received frames on the CAN Network.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>Disabled</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_Disabled_Enabled"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_SamplesPerBit"
                OID="58f052a7-4aa1-47de-a612-b8c5ffcb8405" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_SamplesPerBit</SHORT-NAME>
                <LONG-NAME TI="TI_149049521">CP_SamplesPerBit</LONG-NAME>
                <DESC TI="TI_673493911">
                    <p>Number of samples per bit</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>1-Sample</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT1_SamplesPerBit"/>
            </COMPARAM>
            <COMPARAM CPTYPE="STANDARD" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_SyncJumpWidth"
                OID="ad2354a4-725a-43ea-b635-f255e7105a9d" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_SyncJumpWidth</SHORT-NAME>
                <LONG-NAME TI="TI_1426075715">CP_SyncJumpWidth</LONG-NAME>
                <DESC TI="TI_1030814303">
                    <p>This sets the desired synchronization jump width as a percentage of the bit time.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>15</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT7_0_100_PerCent"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_TerminationType"
                OID="737d374f-c301-4330-bfc8-64e9c40feef0" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_TerminationType</SHORT-NAME>
                <LONG-NAME TI="TI_1476354134">CP_TerminationType</LONG-NAME>
                <DESC TI="TI_14066206">
                    <p>CAN termination settings</p>
                    <p>This ComParam can be used to manually change the termination being used on the vehicle bus line.</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>No termination</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="TEXTTABLE_UINT3_0_4_TerminationType"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_CANFDBaudrate"
                OID="c26a0fff-6c35-4779-b32a-b71db0f16dfa" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_CANFDBaudrate</SHORT-NAME>
                <LONG-NAME TI="TI_1335591270">CP_CANFDBaudrate</LONG-NAME>
                <DESC TI="TI_248136007">
                    <p>Baudrate to be used during the hight bit‐<br/>rate phase of the CANFD frame <br/>transmission/reception. <br/>A value of “0” indicates that CP_Baudrate value will also <br/>be used for the high bitrate of CAN FD. <br/>NOTE Value of ComParam <br/>CP_CANFDTxMaxDataLength controls whether CANFD <br/>is used for TX or not. </p>
                    <p>Type: PDU_PT_UNUM32 Range: [0x0; 0xFFFFFFFF] Resolution: 1 bps Default: 0</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>2000000</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT32_4byte"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_CANFDBitSamplePoint"
                OID="cdbdd7a9-2c96-4e31-927f-733b29c7fe33" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_CANFDBitSamplePoint</SHORT-NAME>
                <LONG-NAME TI="TI_1168347896">CP_CANFDBitSamplePoint</LONG-NAME>
                <DESC TI="TI_1184338864">
                    <p>This sets the desired bit sample point as a <br/>percentage of the bit time to be used during the hight <br/>bit‐rate phase of the CANFD frame <br/>transmission/reception.</p>
                    <p>Type: PDU_PT_UNUM32 Range: [0; 100] Resolution: 1 % Default: 80 %</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>80</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT7_0_100_PerCent"/>
            </COMPARAM>
            <COMPARAM CPTYPE="OPTIONAL" CPUSAGE="TESTER"
                ID="ISO_11898_2_DWCAN.CP_CANFDSyncJumpWidth"
                OID="3ee69067-915d-4d1b-afd3-3f8014f333aa" PARAM-CLASS="BUSTYPE">
                <SHORT-NAME>CP_CANFDSyncJumpWidth</SHORT-NAME>
                <LONG-NAME TI="TI_1838425659">CP_CANFDSyncJumpWidth</LONG-NAME>
                <DESC TI="TI_2017371551">
                    <p>This sets the desired synchronization <br/>jump width as a percentage of the bit time to be used <br/>during the hight bit‐rate phase of the CANFD frame <br/>transmission/reception.</p>
                    <p>Type: PDU_PT_UNUM32 <br/>Range: [0; 100] <br/>Resolution: 1 % Default: 15%</p>
                </DESC>
                <PHYSICAL-DEFAULT-VALUE>15</PHYSICAL-DEFAULT-VALUE>
                <DATA-OBJECT-PROP-REF ID-REF="IDENTICAL_UINT7_0_100_PerCent"/>
            </COMPARAM>
        </COMPARAMS>
        <DATA-OBJECT-PROPS>
