                                <DTC ID="DLC.DLC_VCU.BV.BV_VCU.DOP.DD_DTCList.DTC.DTCP100B41">
                                    <SHORT-NAME>DTCP100B41</SHORT-NAME>
                                    <TROUBLE-CODE>1051457</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P100B41</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1853232192">DTC_L3_FLASH_CONSISTENCY</TEXT>
                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_1202067456">Case 1.) if error occurrence counter &gt;=3 or if the failure is permanent
1.a) replace the ECU (Control units commissioning as specified in technical product description)

Case 2.) otherwise (error occurrence counter &lt;= 2 and failure is not permanent)
2.a.) Delete error memory entry (&lt;customer specific&gt;)
2.b.) Perform test of the system functionality (&lt;customer specific&gt;)
2.c.) read again error memory entry (&lt;customer specific&gt;), if error memory entry is still present - replace the ECU

special measure: SW update (potential errata) in case of SW dependant known issues</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_691848968">VCU startup</SD>
                                            <SD SI="Monitor_Type" TI="TI_1307129560">At Execution time</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_236900631">Software Consistency Error Event occured</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_2039256387">Software Consistency Error Event not occured</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1126449708">Record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1684883797">40 times clamp Cl.15_1 change</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_602647128"> Software Consistency Error Event</SD>
                                            <SD SI="Possible_Impact" TI="TI_102334147">No INV_BUS communication, no HV activation, No Park Lock avaliabe until ignition cycle or automated
cold-restart. If ignition cycle change is not performed in 10 minutes VCU will shutdown itself. Vehicle is only able to roll out. Re-activation of HV is first possible after standstill is reached and ignition cycle change.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_VCU.BV.BV_VCU.DOP.DD_DTCList.DTC.DTCP100BFC">
                                    <SHORT-NAME>DTCP100BFC</SHORT-NAME>
                                    <TROUBLE-CODE>1051644</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P100BFC</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1504974951">DTC_L1_INCOMPLETE_SHDWN</TEXT>
                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_1202067456">Case 1.) if error occurrence counter &gt;=3 or if the failure is permanent
1.a) replace the ECU (Control units commissioning as specified in technical product description)

Case 2.) otherwise (error occurrence counter &lt;= 2 and failure is not permanent)
2.a.) Delete error memory entry (&lt;customer specific&gt;)
2.b.) Perform test of the system functionality (&lt;customer specific&gt;)
2.c.) read again error memory entry (&lt;customer specific&gt;), if error memory entry is still present - replace the ECU

special measure: SW update (potential errata) in case of SW dependant known issues</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_691848968">VCU startup</SD>
                                            <SD SI="Monitor_Type" TI="TI_1307129560">At Execution time</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1229585639">Shutdown Incomplete Error Event occured</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1939193074">Shutdown Incomplete Error Event not occured</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1126449708">Record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1684883797">40 times clamp Cl.15_1 change</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1162141649">Shutdown Incomplete Error Event, If consecutive times a voltage loss on KL30/KL30 happends (line break), in that case the shutdown procedure is not successful finished. The count of consecutive voltage loss is a parameter.</SD>
                                            <SD SI="Possible_Impact" TI="TI_102334147">No INV_BUS communication, no HV activation, No Park Lock avaliabe until ignition cycle or automated
cold-restart. If ignition cycle change is not performed in 10 minutes VCU will shutdown itself. Vehicle is only able to roll out. Re-activation of HV is first possible after standstill is reached and ignition cycle change.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_VCU.BV.BV_VCU.DOP.DD_DTCList.DTC.DTCP100AF0">
                                    <SHORT-NAME>DTCP100AF0</SHORT-NAME>
                                    <TROUBLE-CODE>1051376</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P100AF0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_867000429">DTC_L3_MCU_UNEXPECTED_RESET</TEXT>
                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_1202067456">Case 1.) if error occurrence counter &gt;=3 or if the failure is permanent
1.a) replace the ECU (Control units commissioning as specified in technical product description)

Case 2.) otherwise (error occurrence counter &lt;= 2 and failure is not permanent)
2.a.) Delete error memory entry (&lt;customer specific&gt;)
2.b.) Perform test of the system functionality (&lt;customer specific&gt;)
2.c.) read again error memory entry (&lt;customer specific&gt;), if error memory entry is still present - replace the ECU

special measure: SW update (potential errata) in case of SW dependant known issues</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_691848968">VCU startup</SD>
                                            <SD SI="Monitor_Type" TI="TI_1307129560">At Execution time</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_251040871">Microcontroller is starting up from an Application or System reset which is not expected</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1174091042">Microcontroller is not starting up from an Application or System reset which is expected</SD>
                                            <SD SI="Limp_home_Action" TI="TI_752461108">Record DTC, perform safe-self reset, remain in a Safe state until ignition cycle change</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1684883797">40 times clamp Cl.15_1 change</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_399123218">This DTC indicates that the Microcontroller is starting up from an Application or System reset which is not expected since only "Cold" or "Warm" Porst is expected. Starting up from Application or System Reset leads to an unexpected result in the firmware check.</SD>
                                            <SD SI="Possible_Impact" TI="TI_102334147">No INV_BUS communication, no HV activation, No Park Lock avaliabe until ignition cycle or automated
cold-restart. If ignition cycle change is not performed in 10 minutes VCU will shutdown itself. Vehicle is only able to roll out. Re-activation of HV is first possible after standstill is reached and ignition cycle change.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_VCU.BV.BV_VCU.DOP.DD_DTCList.DTC.DTCP100448">
                                    <SHORT-NAME>DTCP100448</SHORT-NAME>
                                    <TROUBLE-CODE>1049672</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P100448</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1400980584">DTC_L3_PROGRAM_FLOW_MONITORING_L2</TEXT>
                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_1202067456">Case 1.) if error occurrence counter &gt;=3 or if the failure is permanent
1.a) replace the ECU (Control units commissioning as specified in technical product description)

Case 2.) otherwise (error occurrence counter &lt;= 2 and failure is not permanent)
2.a.) Delete error memory entry (&lt;customer specific&gt;)
2.b.) Perform test of the system functionality (&lt;customer specific&gt;)
2.c.) read again error memory entry (&lt;customer specific&gt;), if error memory entry is still present - replace the ECU

special measure: SW update (potential errata) in case of SW dependant known issues</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_691848968">VCU startup</SD>
                                            <SD SI="Monitor_Type" TI="TI_1307129560">At Execution time</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1486845611">-</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1499491633">SW safety functions within L2 are not called in the correct order or cylce</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1385951941">SW safety functions within L2 are called in the correct order or cylce</SD>
                                            <SD SI="Limp_home_Action" TI="TI_752461108">Record DTC, perform safe-self reset, remain in a Safe state until ignition cycle change</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1684883797">40 times clamp Cl.15_1 change</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_246647452">This DTC indicates that the SW safety functions within L2 are not called in the correct order or cylce. The program flow monitoring checks the control flow. In case of a mismatch (not executed, wrong order...) the SSP3 path is asserted.</SD>
                                            <SD SI="Possible_Impact" TI="TI_102334147">No INV_BUS communication, no HV activation, No Park Lock avaliabe until ignition cycle or automated
cold-restart. If ignition cycle change is not performed in 10 minutes VCU will shutdown itself. Vehicle is only able to roll out. Re-activation of HV is first possible after standstill is reached and ignition cycle change.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                            </DTCS>
                        </DTC-DOP>
                    </DTC-DOPS>
