                    <UNIT-SPEC/>
                    <TABLES>
                        <TABLE
                            ID="FG_UDS.TA_ReadDataByIdentECUIdent.Abstract.TABLE"
                            OID="b9b04196-11e4-42a5-beae-3af6a849b274" SEMANTIC="IDENTIFICATION-READ">
                            <!-- 
				Implements the Abstract Table Version (no KEYDOP) to avoid Asam179 Checker Errors
				This Table can not be used 'direct'
							-->
                            <!-- f187 61831 Vehicle Manufacturer Spare Part Number -->
                            <!-- f188 61832 Vehicle Manufacturer ECU Software Number -->
                            <!-- f183 61827 Boot Software Fingerprint -->
                            <!-- f18A 61834 System Supplier Identifier -->
                            <!-- f191 61841 Vehicle Manufacturer ECU Hardware Number -->
                            <!-- f195 61845 System Supplier ECU Software Version Number -->
                            <!-- f18C 61836 ECU Serial Number -->
                            <!-- f186 61830 Active Diagnostic Session -->
                            <!-- f18F 61839 Regulation X Software Identification Numbers (RxSWIN) -->
                            <!-- 0xEFFC Coding Fingerprint Validation -->
                            <!-- 0xA5FF Coding Data String Validation -->
                            <SHORT-NAME>ABSTR_TA_ReadDataByIdentECUIdent</SHORT-NAME>
                            <LONG-NAME TI="TI_1327977310">Read Data By Identifier / ECU Identification (Abstract)</LONG-NAME>
                            <TABLE-ROW
                                ID="FG_UDS.TA_ReadDataByIdentECUIdent.TR_VehicManufSparePartNumbe.TABLE-ROW" OID="144fe9b8-6393-4080-8005-35647a5f82a6">
                                <SHORT-NAME>TR_VehicManufSparePartNumbe</SHORT-NAME>
                                <LONG-NAME TI="TI_1184159555">Vehicle Manufacturer Spare Part Number</LONG-NAME>
                                <KEY>0xF187 Vehicle Manufacturer Spare Part Number</KEY>
                                <STRUCTURE-SNREF SHORT-NAME="ST_StrucVehicManufSparePartNumbe"/>
                            </TABLE-ROW>
                            <TABLE-ROW
                                ID="FG_UDS.TA_ReadDataByIdentECUIdent.TR_VehicManufECUSoftwNumbe.TABLE-ROW" OID="78b4ec25-575f-4792-86f5-e550e4306f20">
                                <SHORT-NAME>TR_VehicManufECUSoftwNumbe</SHORT-NAME>
                                <LONG-NAME TI="TI_1553050536">Vehicle Manufacturer ECU Software Number</LONG-NAME>
                                <KEY>0xF188 Vehicle Manufacturer ECU Software Number</KEY>
                                <STRUCTURE-SNREF SHORT-NAME="ST_StrucVehicManufECUSoftwNumbe"/>
                            </TABLE-ROW>
                            <TABLE-ROW
                                ID="FG_UDS.TA_ReadDataByIdentECUIdent.TR_SysteSupplIdent.TABLE-ROW" OID="fe471bdd-c5b3-45ef-a963-9ed36510ec44">
