                <DIAG-COMMS>
                    <SINGLE-ECU-JOB
                        ID="FG_UDSOnCAN.DC_UDSFlashJob.SINGLE-ECU-JOB"
                        OID="b34c567f-cd20-43e0-ba08-97bcc87cd528" SEMANTIC="FLASHJOB">
                        <SHORT-NAME>DC_UDSFlashJob</SHORT-NAME>
                        <LONG-NAME TI="TI_714229781">UDS Flash Job</LONG-NAME>
                        <DESC TI="TI_187799331">
                            <p>      UDS FlashJob (Standalone)    </p>
                        </DESC>
                        <FUNCT-CLASS-REFS>
                            <FUNCT-CLASS-REF DOCREF="ES_UDSFunctClass"
                                DOCTYPE="LAYER" ID-REF="ES_UDSFunctClass.FC_UploaDownl.FUNCT-CLASS"/>
                        </FUNCT-CLASS-REFS>
                        <PROG-CODES>
                            <PROG-CODE>
                                <CODE-FILE>DSAUDSFlash.jar</CODE-FILE>
                                <SYNTAX>JAR</SYNTAX>
                                <REVISION>13/05</REVISION>
                                <ENTRYPOINT>cn.dsa._flash.flash.UDSFlashJob</ENTRYPOINT>
                            </PROG-CODE>
                        </PROG-CODES>
                        <INPUT-PARAMS>
                            <INPUT-PARAM OID="ce133e74-0562-47eb-a658-9e9d9b222031">
                                <SHORT-NAME>PA_LogLevel</SHORT-NAME>
                                <LONG-NAME TI="TI_65217444">Logging Level (log4j)</LONG-NAME>
                                <PHYSICAL-DEFAULT-VALUE>WARN</PHYSICAL-DEFAULT-VALUE>
                                <DOP-BASE-REF ID-REF="FG_UDSOnCAN.DOP_TextTableJobLog4J.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="403c5e80-b998-4bc5-b7cd-d39795d75948">
                                <SHORT-NAME>PA_ComprEncMethod</SHORT-NAME>
                                <LONG-NAME TI="TI_587123912">Compression and Encrytion Method byte</LONG-NAME>
                                <DESC TI="TI_1008541727">
                                    <p> Compression and Encryption method.
						Magna default is 0</p>
                                </DESC>
                                <DOP-BASE-REF ID-REF="FG_UDSOnCAN.DOP_Any8BitUINT.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="ccdc8be4-abbf-41cb-ad47-e34042571108">
                                <SHORT-NAME>PA_LenAdrField</SHORT-NAME>
                                <LONG-NAME TI="TI_1771258356">Length- and address field Length byte</LONG-NAME>
                                <DESC TI="TI_1446371422">
                                    <p> Length and Address Field.
						Magna default is 68 (0x44)</p>
                                </DESC>
                                <PHYSICAL-DEFAULT-VALUE>68</PHYSICAL-DEFAULT-VALUE>
                                <DOP-BASE-REF ID-REF="FG_UDSOnCAN.DOP_Any8BitUINT.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="ada5a8a0-5fc7-46af-bf30-0b9826982c6f">
                                <SHORT-NAME>PA_Flags</SHORT-NAME>
                                <LONG-NAME TI="TI_2081663729">Flags Field</LONG-NAME>
                                <DESC TI="TI_867692032">
                                    <p>      Parameter can be used to configure additional Job behaviour</p>
                                    <p>      A ";" separated list of flags</p>
                                    <p>      skiperase=DRIVER : A regex pattern for DataBlock Types to skip the erase step for. DRIVER is an example only.</p>
                                    <p>      progresstime=&lt;num&gt; : the time to update the progress in msec. Larger numbers make better performance.</p>
                                    <p>      dryrun=true : No services execution. Only data parsing. Useful to check FlashData.</p>
                                    <p>      tstats=true : Used to make a detailed timing analysis in the job. Results found in LogFile.</p>
                                    <p>      invertcrc=true : Inverts the CRC before sending the Service. 1th complement of the 'normal' CRC32.</p>
                                </DESC>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_AnyAsciiStrin.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM
                                OID="ead0b598-2e71-477f-a3bb-1aa09c6d30cf" SEMANTIC="TERMINATE_CTRL">
                                <SHORT-NAME>PA_Termi</SHORT-NAME>
                                <LONG-NAME TI="TI_1398097573">Parameter to terminate the Job</LONG-NAME>
                                <DESC TI="TI_107898583">
                                    <p>      Parameter can be used to gracefully terminate the Job in case of Cancelation.    </p>
                                    <p>      0 : Default -&gt; Dont terminate   </p>
                                    <p>      1 : Terminate now   </p>
                                </DESC>
                                <PHYSICAL-DEFAULT-VALUE>0</PHYSICAL-DEFAULT-VALUE>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_Termi.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                        </INPUT-PARAMS>
                        <OUTPUT-PARAMS>
                            <OUTPUT-PARAM
                                ID="FG_UDSOnCAN.DC_FlashJob.PA_FlashJobOutpuInfo.OUTPUT-PARAM" OID="967d29bb-9b0f-4623-9e67-3dee27b637af">
                                <SHORT-NAME>PA_FlashJobOutpuInfo</SHORT-NAME>
                                <LONG-NAME TI="TI_1300851361">Flash Job Output Info</LONG-NAME>
                                <DOP-BASE-REF DOCREF="ES_UDSFlash"
                                    DOCTYPE="LAYER" ID-REF="ES_UDSFlash.ST_StrucFlashJobOutpuInfo.STRUCTURE"/>
                            </OUTPUT-PARAM>
                        </OUTPUT-PARAMS>
                        <NEG-OUTPUT-PARAMS>
                            <NEG-OUTPUT-PARAM>
                                <SHORT-NAME>NPA_FlashJobOutpuInfo</SHORT-NAME>
                                <LONG-NAME TI="TI_1300851361">Flash Job Output Info</LONG-NAME>
                                <DOP-BASE-REF DOCREF="ES_UDSFlash"
                                    DOCTYPE="LAYER" ID-REF="ES_UDSFlash.ST_StrucFlashJobOutpuInfo.STRUCTURE"/>
                            </NEG-OUTPUT-PARAM>
                        </NEG-OUTPUT-PARAMS>
                    </SINGLE-ECU-JOB>
                    <SINGLE-ECU-JOB
                        ID="DLC.FG_UDS.ESD.ES_UDS.DC.DC_SecurAccesJob"
                        OID="1dc74847-4d44-48e8-b554-e13e50f8d0e3" SEMANTIC="SECURITY">
                        <SHORT-NAME>DC_SecurAccesJob</SHORT-NAME>
                        <LONG-NAME TI="TI_558508247">Security Access Job</LONG-NAME>
                        <DESC TI="TI_292584841"/>
                        <FUNCT-CLASS-REFS>
                            <FUNCT-CLASS-REF DOCREF="ES_UDSFunctClass"
                                DOCTYPE="LAYER" ID-REF="ES_UDSFunctClass.FC_DiagnAndCommuManag.FUNCT-CLASS"/>
                            <FUNCT-CLASS-REF DOCREF="ES_UDSFunctClass"
                                DOCTYPE="LAYER" ID-REF="ES_UDSFunctClass.FC_SecurAcces.FUNCT-CLASS"/>
                        </FUNCT-CLASS-REFS>
                        <PROG-CODES>
                            <PROG-CODE>
                                <CODE-FILE>FiskerOceanSingleECUJobs.jar</CODE-FILE>
                                <SYNTAX>JAR</SYNTAX>
                                <REVISION>13/05</REVISION>
                                <ENTRYPOINT>cn.dsa.sejs.securityaccess.FiskerOceanSecAccessJob</ENTRYPOINT>
                            </PROG-CODE>
                        </PROG-CODES>
                        <INPUT-PARAMS>
                            <INPUT-PARAM OID="099e6010-bd7f-4337-8246-7efeccae52e1">
                                <SHORT-NAME>PA_LogLevel</SHORT-NAME>
                                <LONG-NAME TI="TI_65217444">Logging Level (log4j)</LONG-NAME>
                                <DESC TI="TI_292584841"/>
                                <PHYSICAL-DEFAULT-VALUE>WARN</PHYSICAL-DEFAULT-VALUE>
                                <DOP-BASE-REF ID-REF="FG_UDSOnCAN.DOP_TextTableJobLog4J.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="07d86d3e-ec1f-4aa8-aff1-f8adf8fadb85">
                                <SHORT-NAME>PA_AccesLevel</SHORT-NAME>
                                <LONG-NAME TI="TI_338851111">Access Level</LONG-NAME>
                                <DESC TI="TI_292584841"/>
                                <PHYSICAL-DEFAULT-VALUE>Level 1</PHYSICAL-DEFAULT-VALUE>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_TextTableSecurAccesJobLevel.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="6e882dc6-d1f3-4e18-b54e-14cc6696dfd8">
                                <SHORT-NAME>PA_Flags</SHORT-NAME>
                                <LONG-NAME TI="TI_2081663729">Flags Field</LONG-NAME>
                                <DESC TI="TI_1220048599">
                                    <p>      Parameter can be used to configure additional Job behaviour</p>
                                    <p>      A ";" separated list of flags</p>
                                    <p>      dryrun=true : No services execution. Only data parsing. Useful to check Sequrity Access data handling.</p>
                                    <p>      tstats=true : Used to make a detailed timing analysis in the job. Results found in LogFile.</p>
                                    <p>      store=&lt;name&gt; : optional parameter. name=(FRS90|FRS350) - Default is FRS90.</p>
                                </DESC>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_AnyAsciiStrin.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                            <INPUT-PARAM OID="5a3fd9f3-6b9c-4867-aa30-aca84a076ae7">
                                <SHORT-NAME>PA_PrivaKey</SHORT-NAME>
                                <LONG-NAME TI="TI_1242805144">Private Key</LONG-NAME>
                                <DESC TI="TI_1945019450">
                                    <p>The (optional) private Key (ByteField)</p>
                                    <p>The Job will find that key in the encrypted keystore (if DSA MCD Kernel)<br/>This Parameter is for the NON DSA Kernel Testers</p>
                                </DESC>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_AnyByteField.DATA-OBJECT-PROP"/>
                            </INPUT-PARAM>
                        </INPUT-PARAMS>
                        <OUTPUT-PARAMS>
                            <OUTPUT-PARAM
                                ID="DLC.DLC_FG_UDSOnCAN.FG.FG_UDSOnCAN.DC.DC_SecurAccesJob.OP.PA_Statu" OID="300934d8-50c0-4e8b-99bc-1638e00945ca">
                                <SHORT-NAME>PA_Statu</SHORT-NAME>
                                <LONG-NAME TI="TI_1262226758">Status</LONG-NAME>
                                <DOP-BASE-REF ID-REF="FG_UDS.DOP_AnyAsciiStrin.DATA-OBJECT-PROP"/>
                            </OUTPUT-PARAM>
                            <OUTPUT-PARAM
                                ID="DLC.DLC_FG_UDSOnCAN.FG.FG_UDSOnCAN.DC.DC_SecurAccesJob.OP.PA_Messa" OID="43ec3cc3-a76c-472e-ba91-c1526bddedff">
                                <SHORT-NAME>PA_Messa</SHORT-NAME>
