            <DATA-OBJECT-PROP
                ID="TEXTTABLE_UINT4_0_10_CanRespUUDTFormat" OID="57e929b5-18b3-433c-abd0-031dad35ddc0">
                <SHORT-NAME>TEXTTABLE_UINT4_0_10_CanRespUUDTFormat</SHORT-NAME>
                <LONG-NAME TI="TI_680522902">TEXTTABLE_UINT4_0_10_CanRespUUDTFormat</LONG-NAME>
                <COMPU-METHOD>
                    <CATEGORY>TEXTTABLE</CATEGORY>
                    <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                            <COMPU-SCALE>
                                <SHORT-LABEL TI="TI_1542109417">0x0</SHORT-LABEL>
                                <DESC TI="TI_1812993456">
                                    <p>- Normal addressing for Target (ECU)</p>
                                    <p>- UUDT Message Transmit (No PCI Bytes)</p>
                                    <p>- 11-bit CAN ID Size</p>
                                    <p>- UUDT Message Receive (No Flow Control)</p>
                                </DESC>
                                <LOWER-LIMIT>0</LOWER-LIMIT>
                                <COMPU-CONST>
                                    <VT TI="TI_1914058375">normal unsegmented 11-bit receive</VT>
                                </COMPU-CONST>
                            </COMPU-SCALE>
                            <COMPU-SCALE>
                                <SHORT-LABEL TI="TI_1036537644">0x2</SHORT-LABEL>
                                <DESC TI="TI_359502804">
                                    <p>- Normal addressing for Target (ECU)</p>
                                    <p>- UUDT Message Transmit (No PCI Bytes)</p>
                                    <p>- 29-bit CAN ID Size</p>
                                    <p>- UUDT Message Receive (No Flow Control)</p>
                                </DESC>
                                <LOWER-LIMIT>2</LOWER-LIMIT>
                                <COMPU-CONST>
                                    <VT TI="TI_1802714873">normal unsegmented 29-bit receive</VT>
                                </COMPU-CONST>
                            </COMPU-SCALE>
