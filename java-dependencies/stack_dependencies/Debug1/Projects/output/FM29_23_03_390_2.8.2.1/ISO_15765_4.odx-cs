                    <BIT-LENGTH>32</BIT-LENGTH>
                </DIAG-CODED-TYPE>
                <PHYSICAL-TYPE BASE-DATA-TYPE="A_UINT32"/>
                <INTERNAL-CONSTR>
                    <SCALE-CONSTRS>
                        <SCALE-CONSTR VALIDITY="NOT-DEFINED">
                            <LOWER-LIMIT>127001</LOWER-LIMIT>
                            <UPPER-LIMIT>4294967294</UPPER-LIMIT>
                        </SCALE-CONSTR>
                    </SCALE-CONSTRS>
