                            <DTCS>
                                <DTC ID="DLC.DLC_PWC_L.BV.BV_PWC_L.DOP.DD_DTCList.DTC.DTCU1B4000" OID="af97deee-c1c7-4841-b906-4e122409a2f0">
                                    <SHORT-NAME>DTCU1B4000</SHORT-NAME>
                                    <TROUBLE-CODE>14368768</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U1B4000</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_861493793">Vehicle CAN Bus OFF</TEXT>
                                    <LEVEL>1</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                            <SD SI="Repair_Action" TI="TI_1853550037">(1) Check whether the battery voltage is 9 V~16 V
(2) Reconnect the battery/power supply
(3) Check whether the CAN bus connection is normal</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1161427814">ignition ON or ECU is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_2089778346">Periodically</SD>
                                            <SD SI="Monitor_Rate" TI="TI_551444254">10 ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_618190687">Occurrence of busoff for more than or equal to 3 times</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1870749588">The communication busoff returns</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1136878772">Record DTC; Function degradation</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1954327066"> Signal incompatibility caused by transmission or harness problems
 Short circuit between CAN_H/CAN_L</SD>
                                            <SD SI="Possible_Impact" TI="TI_961760369">controller does not work properly</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_PWC_L.BV.BV_PWC_L.DOP.DD_DTCList.DTC.DTCU1B4100" OID="599bfce1-9444-495b-95d0-7f4a359317c3">
                                    <SHORT-NAME>DTCU1B4100</SHORT-NAME>
                                    <TROUBLE-CODE>14369024</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U1B4100</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_664208944">Keys corrupted</TEXT>
                                    <LEVEL>1</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                            <SD SI="Repair_Action" TI="TI_2010068840">(1) Check whether the battery voltage is 9 V~16 V
(2) Reconnect the battery/power supply</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1605975711"> Local voltage is within normal range (9-16V) 
 PwrMod == IGN ON</SD>
                                            <SD SI="Monitor_Type" TI="TI_1146888022">Event trigger</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1874126332">During Start up &amp; key Load</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1790890816">The component shall set the DTC Immediately if any of the below listed conditions occurs:
(a) Key Storage into Memory Failed (Example Encryption failed)
(b) Key retrieval from Memory Failed (Example  CRC/Checksum/Hash/Decryption failed)
(C) Loading the Key to HSM or equivalent function failed.
</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1741408636">The component shall not set any DTC if the ECU is able to read and write the key successfully from its memory</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1979650367">Record DTC; Use Default Keys</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_713616109">Unable to use correct private key to unlock Service 0x27 SecurityAccess</SD>
                                            <SD SI="Possible_Impact" TI="TI_23291386">UDS Service 0x27 SecurityAccess not work properly</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_PWC_L.BV.BV_PWC_L.DOP.DD_DTCList.DTC.DTCB24F800" OID="3b759a3d-98ff-4475-9485-5a9808ea5e25">
                                    <SHORT-NAME>DTCB24F800</SHORT-NAME>
                                    <TROUBLE-CODE>10811392</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B24F800</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_653147192">Tempurature Sensor Fault</TEXT>
                                    <LEVEL>1</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                            <SD SI="Repair_Action" TI="TI_481177440">(1) Check the temperature
(2) Reconnect the battery/power supply</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1544496510">Ignition ON or ECU is awake</SD>
                                            <SD SI="Monitor_Type" TI="TI_2089778346">Periodically</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1451217794">10ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_552092307">At least on of temperature sensor is open or shorted and ERR kept for 1000ms</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_981349290">the system temperature is less than 75 degrees for 1000ms</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1136878772">Record DTC; Function degradation</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1418629425">the system temperature exceeds 75 degrees for 1000ms</SD>
                                            <SD SI="Possible_Impact" TI="TI_531789708">PWC-L feature is not available</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                            </DTCS>
                        </DTC-DOP>
                    </DTC-DOPS>
