                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1999390981">0</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_624958274">EDM_SYSTEMCOND_SFTY_TB_LV_PT_PET_ON_TR_P1_P2_INIT_FR_FT_FP_FltIrrv_RI</SD>
