                                            <SD SI="Cause_of_Failure" TI="TI_213962300">IoEcuMv:
((IoEcu_rHwDiagPinLvl.EmInvPhase1CurrHigh ==
   DIO_ACTVLVL_HWDIAG_STS) ||
  (IoEcu_rHwDiagEventCnt.EmInvPhase1CurrHigh &gt; 0)
) &amp;&amp; (!IoEcu_iEmPwrStgFbSwAscActvSts)


IoEcuHv:
IoEcu_iEmCbkFltHndlg.InvPhaseCurr1HighCnt != prev(IoEcu_iEmCbkFltHndlg.InvPhaseCurr1HighCnt)</SD>
