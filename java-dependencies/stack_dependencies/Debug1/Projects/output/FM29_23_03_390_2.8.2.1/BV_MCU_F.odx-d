                                <DTC ID="DLC.DLC_MCU_F.BV.BV_MCU_F.DOP.DD_DTCList.DTC.DTCP119447">
                                    <SHORT-NAME>DTCP119447</SHORT-NAME>
                                    <TROUBLE-CODE>1152071</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P119447</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1108414663">DTC_L3_PROGRAM_FLOW_MONITORING_L3</TEXT>
                                    <LEVEL>0</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1999390981">0</SD>
                                            <SD SI="Repair_Action" TI="TI_1149784781">Software Update</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_474518921">EDM_SYSTEMCOND_ALWAYS_ON</SD>
                                            <SD SI="Monitor_Type" TI="TI_1307129560">At Execution time</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1999390981">0</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1999390981">0</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1999390981">0</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1999390981">0</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1999390981">0</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1109717619"><![CDATA[The failure event "EVENT_L3_PROGRAM_FLOW_MONITORING_L3" is set:
If a software element is not executed within right program order or within defined period/frequency.

Failure Indication by:
1.) if the RSTb bit of the WD ANSWER register reports a "Reset"
(WD_ANSWER: RSTB == 1)
2.) and the FSxB bit of the WD ANSWER register reports a "Fail-safe event"
&& (WD_ANSWER: FSxB == 1)
3.) and the WD_BAD_TIMING bit of the WD ANSWER register reports a "wrong WD timing refresh" or the WD_BAD_DATA bit reports a "wrong WD data refresh"
&& ((WD_ANSWER: WD_BAD_TIMING == 1) || (WD_ANSWER: WD_BAD_DATA == 1))
4.) and the marker in the reset proof RAM indicates a program flow failure
&& (RPRAM_ProgramFlow == 1)]]></SD>
                                            <SD SI="Possible_Impact" TI="TI_1999390981">0</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_MCU_F.BV.BV_MCU_F.DOP.DD_DTCList.DTC.DTCP119448">
                                    <SHORT-NAME>DTCP119448</SHORT-NAME>
                                    <TROUBLE-CODE>1152072</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P119448</DISPLAY-TROUBLE-CODE>
