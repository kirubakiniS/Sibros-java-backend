                                <DTC ID="DTCB206516" OID="778c8ac0-ea32-4f94-9bdb-ddf9244f1713">
                                    <SHORT-NAME>DTCB206516</SHORT-NAME>
                                    <TROUBLE-CODE>10511638</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B206516</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_691616701">Battery Voltage Failure  -  voltage is below threshold</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_712412735">1. Check battery voltage.</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1282258365">Ignition ON</SD>
                                            <SD SI="Monitor_Type" TI="TI_1620650512">Continous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_603488216">100ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_960971780">Battery voltage below 9V for 2 seconds</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1061637054">Battery voltage equal or above 9V</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1589627569">1. Deactivation of internal/external lights/lamps</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1777454293">1. If first failure criteria occurs the aging counter is set to 40
2. If error-free detection cycle without a "test failed" in previous and current driving cycle, aging counter is decremented by 1 
3. If aged counter reaches 0, the DTC Aged Criteria is fufilled</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1225764565">Battery voltage too low.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
