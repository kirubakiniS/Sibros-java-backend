    <COMPARAM-SUBSET CATEGORY="APP" ID="ISO_14229_3" OID="aba4fadc-fb14-4d52-8fc2-75a43fcd33b0">
        <SHORT-NAME>ISO_14229_3</SHORT-NAME>
        <LONG-NAME TI="TI_1182875735">ISO 14229-3</LONG-NAME>
        <DESC TI="TI_1363922946">
            <p>ISO 14229-3 is the successor of ISO 15765-3 with identical features and functions </p>
        </DESC>
        <ADMIN-DATA>
            <LANGUAGE>en-UK</LANGUAGE>
            <DOC-REVISIONS>
