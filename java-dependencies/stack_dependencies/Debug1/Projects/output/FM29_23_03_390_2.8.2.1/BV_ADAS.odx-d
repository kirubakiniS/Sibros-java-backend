                    <PARENT-REF DOCREF="ES_UDSGener" DOCTYPE="LAYER" ID-REF="ES_UDSGener" xsi:type="ECU-SHARED-DATA-REF"/>
                </PARENT-REFS>
            </BASE-VARIANT>
        </BASE-VARIANTS>
    </DIAG-LAYER-CONTAINER>
</ODX>
