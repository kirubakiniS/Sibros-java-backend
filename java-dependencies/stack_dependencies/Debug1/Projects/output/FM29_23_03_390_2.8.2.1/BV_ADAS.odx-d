                                <DTC ID="DLC.DLC_ADAS.BV.BV_ADAS.DOP.DD_DTCList.DTC.DTCC21B300">
                                    <SHORT-NAME>DTCC21B300</SHORT-NAME>
                                    <TROUBLE-CODE>6402816</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C21B300</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1259986832">ADAS DC Trip Counter failure</TEXT>
                                    <LEVEL>1</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1732356815">Service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_849435653">TBD</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1460260769">- Local voltage is within normal range (9-16V)  - BCM_PwrMod == IGN ON(0x2)||RUN(0x4)  - BUS physical status  - De-bounce timer</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1451217794">10ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1119429346">The Hydra3_component shall set the DTC if ADAS DC is not able to read or write trip counter data onto the NVM block</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_2079138255">Read /write trip counter data onto the NVM block is successful</SD>
                                            <SD SI="Limp_home_Action" TI="TI_185005103">For High-Speed Safety features:   FID_AEB_Critical_Impact FID_VRU_Critical_Impact FID_SCP_Critical_Impact FID_RCTAB_Critical_Impact FID_LTAP_Critical_Impact FID_ESA_Critical_Impact FID_LKA_Critical_Impact Features that are in error state/Not available/Deactivated: All the comfort features and low speed safety features will be unavailable.   Comfort and low speed safety Feature List - 1. Lane Change Assist (LCA) 2. Traffic jam assist (TJA) 3. Integrated Cruise Assist (ICA) 4. Automatic Cruise Control (ACC) Including Stop and Go 5. Auto High Beam (AHB) 6. Intelligent Speed Assist (ISA) 7. Blind Spot Monitoring (BSM) 8. Traffic Sign/Light Recognition (TSLR) 9. Door Opening Incident Warning (DOIW)   10. Automatic Emergency Braking - Premium Rear Automatic Emergency Braking: RAEB 11. Wheel scratch-prevention Parking Assist  (WSP) 12. Full Automatic Park Assist System (APA) 13. Personal Park Assist 14. Remote Parking Assist</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_491091207">40 Drive Cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1833742231">Memory corruption issue</SD>
                                            <SD SI="Possible_Impact" TI="TI_722038729">The trip counter is set to the initial value</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_ADAS.BV.BV_ADAS.DOP.DD_DTCList.DTC.DTCU15B616" IS-TEMPORARY="true">
