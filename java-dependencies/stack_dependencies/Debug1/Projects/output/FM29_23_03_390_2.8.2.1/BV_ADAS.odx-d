                                            <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                            <SD SI="Repair_Action" TI="TI_849435653">TBD</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_437657501">- Local voltage is within normal range (9-16V)  - BCM_PwrMod == IGN ON(0x2)||RUN(0x4)  - BUS physical status  - DTC for Loss of Communication with MCU that has both Rear and Front motor (U15C0-87) is not present  - De-bounce timer </SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_551444254">10 ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_2118450006">For the message MCU_F_0x150 || MCU_F_0x383 || MCU_R_0x151, if - Check Sum verification error occurs in the last 3 consecutive messages OR - Maximum difference of Counter value (MaxDeltaCounterInit) &gt; 1 for 3 times continuously OR - Counter value is repeated in the last 3 consecutive messages OR - During normal communication between sending node and receiving node, Counter = 0x0F repeats 3 times continuously</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1387777159">DTC shall not be set if all the conditions below are met and last for 1 period  - Check Sum is correct; - Counter maximum difference (MaxDeltaCounterInit)  =  1; - The Counter value is not repeated; - During normal communication between sending node and receiving node, Counter = 0x0F does not appear</SD>
                                            <SD SI="Limp_home_Action" TI="TI_849435653">TBD</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_983679744">40 Drive cycle</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_149327311">1. The ECU/module is gone to sleep 2. Gateway forwarding error 3. Associated ECU Fault</SD>
                                            <SD SI="Possible_Impact" TI="TI_213653177">Features relying on MCU_F and MCU_R messages will be degraded or unavailable</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DLC.DLC_ADAS.BV.BV_ADAS.DOP.DD_DTCList.DTC.DTCU15C087">
                                    <SHORT-NAME>DTCU15C087</SHORT-NAME>
                                    <TROUBLE-CODE>14008455</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U15C087</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_327609581">Loss of Communication with Motor Control Unit (Both MCU_Front and MCU_Rear available) </TEXT>
                                    <LEVEL>3</LEVEL>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_781636891">Check at next stop</SD>
                                            <SD SI="Repair_Action" TI="TI_849435653">TBD</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1685949360">- Local voltage is within normal range (9-16V)  - BCM_PwrMod == IGN ON(0x2)||RUN(0x4)  - BUS physical status  - De-bounce timer </SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1451217794">10ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_16836422">CAN message MCU_F_0x150 || MCU_F_0x383 || MCU_R_0x151 is missing for 100 msec</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_654982799">Received the lost messages from MCU_Front and MCU_Rear and message is present for 100 msec </SD>
