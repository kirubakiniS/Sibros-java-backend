                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1201157572">EC-1 Ignition Status &amp;&amp; EC-4 Debounce Timer</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_777418231">1sec</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_99836212">Battery Voltage &lt; 8.5 V and last for 10 sec</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_310753292">Battery Voltage &gt; = 8.5 V for 10 sec</SD>
                                            <SD SI="Limp_home_Action" TI="TI_231827387">No output video/signal</SD>
