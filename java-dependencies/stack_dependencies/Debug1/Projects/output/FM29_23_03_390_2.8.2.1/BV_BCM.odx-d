                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_2025466953">15ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_705431075">The BCM shall consider that the Left Front Turn Indicator Feedback is in short-to-ground  if 100ms after Turn Indicator Left is turned OFF and while it remains in OFF, the feedback line input is read as LOW for 200ms.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1376059687">The BCM shall consider that the Left Front Turn Indicator Feedback is no longer in short-to-ground condition if 100ms after Turn Indicator Left is turned OFF and while it remains in OFF the feedback line input is read as HIGH for 200ms</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1271650196">Record the DTC
Send CAN Message BCM_LeTurnLampFlt=0x1</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_906674784">The DTC is triggered by the status of the logical input of the turn indicator's feedback line.</SD>
                                            <SD SI="Possible_Impact" TI="TI_502740959">The status of the Turn Indicator Lamp may not be accuretly detected by BCM.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
