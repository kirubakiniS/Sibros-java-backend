                                <DTC ID="DTCB21A800" OID="6b26d8f2-c0fe-476e-8f5f-708116053187">
                                    <SHORT-NAME>DTCB21A800</SHORT-NAME>
                                    <TROUBLE-CODE>10594304</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A800</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1876940853">Keys [Symmetric key/Key-Raw] corrupted</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1788665557">service at next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_682076469">Rewrite the Key via DID $EFF5</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1875418140">Voltage supply of BCM is between 9v-16v, IGN = ON and communication is active</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1305815586">The component shall set the DTC Immediately if any of the below listed conditions occurs:?(a) Key Storage into Memory Failed (Example Encryption failed)?(b) Key retrieval from Memory Failed (Example  CRC/Checksum/Hash/Decryption failed)?(c) All bytes of Raw_Key are either 0x00 (initial value) or 0xFF.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1410371878">The component shall not set any DTC if the ECU is able to read and write the key-raw successfully from its memory</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1234304460">Key value CRC set as invalid/corrupted
Memory Key Storage failed
Key Values are equal to default value (0x00 or 0xFF)</SD>
                                            <SD SI="Possible_Impact" TI="TI_765889656">SEC OC messages not validated</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCB21A900" OID="f4211776-f51e-4d3e-aa09-ebff1e07c769">
                                    <SHORT-NAME>DTCB21A900</SHORT-NAME>
                                    <TROUBLE-CODE>10594560</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A900</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_2087522592">HSM/SW Algorithm initialization Failure</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_682076469">Rewrite the Key via DID $EFF5</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1130439501">Voltage supply of BCM is between 9v-16v and IGN = ON</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_372195596">The component shall set the DTC Immediately if the return value of HSM/SW Algorithm initialization failed or unsuccessful. Since initialization happens at the startup, the Failure will be latched until the same HSM initialization function is called again (i.e. entire ECU power cycle).</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1119381329">The component shall not set any DTC if the HSM initialization is Passed or successful</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1222695008">Key stored are corrupted</SD>
                                            <SD SI="Possible_Impact" TI="TI_1128920215">SEC OC messages not validated
Sec Level 1, 2 and 3 not available</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
