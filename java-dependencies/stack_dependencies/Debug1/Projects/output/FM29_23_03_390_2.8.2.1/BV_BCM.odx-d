                                <DTC ID="DTCB219512" OID="54e2846c-cf95-4209-b637-2319462b3317">
                                    <SHORT-NAME>DTCB219512</SHORT-NAME>
                                    <TROUBLE-CODE>10589458</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B219512</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1843829532">Rear and mirror defrost relay output circuit current above threshold/short to Batt</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_1011116126">Check circuit of Defroster</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_2115671428">Voltage supply of BCM is in the range of 9-16V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_592668466">20ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1551821929">The output current  will be checked to monitor the   short to battery failure, if the current is higher than specific HW threshold, it's considered as short to battery failure.
Short to Battery for 200ms</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_985058756">The output current  will be checked to monitor the  short to battery failure, if the current is lower than specific HW threshold, it's considered as No short to battery failure.
 NOT Short to Battery for 100ms</SD>
                                            <SD SI="Limp_home_Action" TI="TI_190625855">Record the DTC
Cut Output</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_782852250">this DTC will activate if the current is higher than threshold defined during a predetermined time.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1708363698">Activation of defroster functionality will not be available for the driver</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
