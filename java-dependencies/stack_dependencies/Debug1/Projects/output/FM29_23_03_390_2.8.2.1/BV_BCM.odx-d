                                    <DISPLAY-TROUBLE-CODE>B219A14</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1340527514">IGN1 Relay short to GND/Open</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_392746800">service immediately</SD>
                                            <SD SI="Repair_Action" TI="TI_467265088">Examine KL15_1 relay and replace it if necessary.</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1339413613">Voltage in operative range (9V to 16V) and IGN = OFF</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_592668466">20ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_946747283">KL15_1 Relay is requested ON (connector pin J3_34) and relay feedback is read as OFF (connector pin J1_02) for 1000ms.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_958793499">KL15_1 Relay is requested ON (connector pin J3_34) and relay feedback is read as ON (connector pin J1_02) for 1000ms.</SD>
