                                <DTC ID="DTCB21A300" OID="fe8068c2-f287-415f-9730-9c59a6615378">
                                    <SHORT-NAME>DTCB21A300</SHORT-NAME>
                                    <TROUBLE-CODE>10593024</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A300</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1670609038">Trip/Reset/Message Counters and Reset Flag Range Check Failures</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_686384348">Check ECU</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1130439501">Voltage supply of BCM is between 9v-16v and IGN = ON</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1639224749">The component shall set the DTC If?- Reset or Message counter are at its maximum range.?OR ?- Abnormal freshness value synchronization message is received (if received freshness values are not within tolerance value); The tolerance value is considered as 3.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_814694139">The component shall clear the DTC immediately If Trip/Reset/Message Counters and Reset Flag are within its Ranges.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1164216943">Reset or MEC value at maximum
Freshness received value is higher or lower as expected by +/- 3</SD>
                                            <SD SI="Possible_Impact" TI="TI_765889656">SEC OC messages not validated</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCB21A400" OID="ca439df5-105f-42bf-99f1-924b8e74f064">
                                    <SHORT-NAME>DTCB21A400</SHORT-NAME>
                                    <TROUBLE-CODE>10593280</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A400</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1307267594">Trip Counter not updated between Ignition cycles and NVM Read/Write Error</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_686384348">Check ECU</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1875418140">Voltage supply of BCM is between 9v-16v, IGN = ON and communication is active</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1183336224">The component shall set the DTC if any of the below listed conditions occurs:?- Trip counter not updated across Ignition cycles?- Trip counter data can not be written or read from NVM</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_800738930">The component shall clear the DTC if Trip counter is getting updated properly across Ignition cycles at least once or NVM Write/Read successful.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_180439130">Trip counter not updated after an Ignition Cycle
Trip counter is not available for writting or reading in NVM</SD>
                                            <SD SI="Possible_Impact" TI="TI_765889656">SEC OC messages not validated</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCB21A500" OID="fcd57fd1-99af-45ac-b7fa-edf8870e947e">
                                    <SHORT-NAME>DTCB21A500</SHORT-NAME>
                                    <TROUBLE-CODE>10593536</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A500</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1787630157">Driver door unlock relay stuck</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1788665557">service at next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_2096001706">- Check wiring to BCM
- Check wiring of driver door lock feedback
- Replace controller</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_2115671428">Voltage supply of BCM is in the range of 9-16V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_592668466">20ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_2070359179">The feedback of driver door lock will be compared against the microcontroller pin activation. If no activation request is set by microncontroller and the feedback received is relay activated, an stuck on ON is considered.  If an activation request is set by microncontroller and the feedback received is relay inactive, an stuck on OFF is considered.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1620225558">At the next activation of driver door unlock the feedback of driver door lock will be compared against the microcontroller outputs. If feedback match with activation of microcontroller state, DTC is stored.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1126449708">Record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1576283039">This DTC is detonated if the locking feedback received via digital input have a mismatch with the intended activation of the door locking motors.</SD>
                                            <SD SI="Possible_Impact" TI="TI_2105167634">Control of door locking not responding according to user requests.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCB21A600" OID="8ce3ebd8-cf98-4953-aeff-d2c95a612541">
                                    <SHORT-NAME>DTCB21A600</SHORT-NAME>
                                    <TROUBLE-CODE>10593792</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A600</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_538373075">Reset counter not updated or uncontrolled Jump</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_686384348">Check ECU</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1875418140">Voltage supply of BCM is between 9v-16v, IGN = ON and communication is active</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1949483390">The component shall set the DTC If  any of the below listed conditions occurs:?- Reset counter not updated continuously for 3 second?- uncontrolled jump of more than 10 counts w.r.to previous received sync message.?- Reset Counter reaches its Maximum value or When an increment condition of the reset counter occurs at the maximum value ?of the reset counter.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1273924928">The component shall clear the DTC if Reset counter is getting updated properly every one second at least once.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_224357498">After 3 seconds reset counter was not updated
Received value not expected of 10 counts
Reset counter reached its maximum value</SD>
                                            <SD SI="Possible_Impact" TI="TI_765889656">SEC OC messages not validated</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCB21A700" OID="21d77294-0e28-4eda-9215-9c511414be12">
                                    <SHORT-NAME>DTCB21A700</SHORT-NAME>
                                    <TROUBLE-CODE>10594048</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A700</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1865797198">Message counter not updated or uncontrolled Jump</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_712048008">no service</SD>
                                            <SD SI="Repair_Action" TI="TI_686384348">Check ECU</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1875418140">Voltage supply of BCM is between 9v-16v, IGN = ON and communication is active</SD>
                                            <SD SI="Monitor_Type" TI="TI_67683176">If active</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1129422690">The component shall set the DTC If any of the below listed conditions occurs:?- Message counter not updated continuously for 3 messages.?- uncontrolled jump of more than 20 counts w.r.to previous received message.?- Message Counter reaches its Maximum value or When an increment condition of the Message counter occurs at the maximum value ?of the Message counter.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1892623778">The component shall clear the DTC if Message counter is getting updated properly at least once in subsequent message.</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1017697622">Record the DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_651423811">Message counter not updated within 3 messages
Message counter skiped 20 count from expected value
