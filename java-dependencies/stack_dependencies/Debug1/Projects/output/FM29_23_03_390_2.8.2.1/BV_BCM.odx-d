                                            <SD SI="DTC_Aged_Crieria" TI="TI_740727462">After 100 IGN ON to OFF cycles,clear history DTC automatically</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_766882641">KL15_1 relay is open or its output is shorted to ground.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1892939">Battery voltage at KL15_1 line not available.</SD>
                                        </SDG>
                                    </SDGS>
