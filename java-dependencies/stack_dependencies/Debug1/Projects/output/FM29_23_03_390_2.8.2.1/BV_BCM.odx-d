                                <DTC ID="DTCB21A200" OID="3b6c7c52-2a94-475c-a9d4-7567a1095b27">
                                    <SHORT-NAME>DTCB21A200</SHORT-NAME>
                                    <TROUBLE-CODE>10592768</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>B21A200</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_166315063">Consumer reduction</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1788665557">service at next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_1446413358">- Check battery voltage
- Replace battery
- Re-connect BCM module to confirm connection</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1869271363">Battery SOC &lt;60%</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_73335078">50ms</SD>
