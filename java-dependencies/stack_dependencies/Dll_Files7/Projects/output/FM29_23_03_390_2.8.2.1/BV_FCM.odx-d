                      <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                      <SD SI="Monitor_Rate" TI="TI_551444254">10 ms</SD>
                      <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1628685571">1.Internal Voltages is out of tolerance
