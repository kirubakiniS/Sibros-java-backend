                                            <SD SI="Monitor_Rate" TI="TI_1373385027">20 ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1120304372">RSHM diagnostics error</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_654784639">RSHM diagnostics no error</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1626654505">RSHM does not work correctly</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1203974766">40 dec</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1998933147">See DTC error description</SD>
                                            <SD SI="Possible_Impact" TI="TI_608261288">RSHM heater off</SD>
                                        </SDG>
                                    </SDGS>
