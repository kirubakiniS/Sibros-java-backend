                                    <DISPLAY-TROUBLE-CODE>P12C919</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1887902058">DC-DC Converter output short circuit</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_142609411">1. Check the output harness connection
2. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_93020266">1. The 12V battery voltage above 9V and below 18V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_519783579">1.IOUT&gt;2.7A, and VOUT&lt;30V,t&gt;200ms
OR 2.IOUT&gt;3.0A, and VOUT&lt;30V,t&gt;1ms</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_210834516">Auto-cleared after DC-DC converter disable output</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_83443707">1. Output terminal connection abnormal
2. Output voltage detection circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_689841219">1. Disable output, and try to recovery after 3s
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCP12CA00" OID="50fcdc81-249e-4d08-bdd7-968a083fc3c5">
                                    <SHORT-NAME>DTCP12CA00</SHORT-NAME>
                                    <TROUBLE-CODE>1231360</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P12CA00</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1892138619">DC-DC Converter input available power under threshold</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_1828494165">1. Check the voltage of solar panel
2. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1117479213">1. The 12V battery voltage above 9V and below 18V
AND 2. DC-DC converter works in the state of charging</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_287931434">InputPowerAvail&lt;40W,t&gt;10min</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_210834516">Auto-cleared after DC-DC converter disable output</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_2125741419">1. The solar panel  is abnormal
2. In the absence of sunlight
3. Input voltage detection circuit abnormal
4. Input current detection circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_689841219">1. Disable output, and try to recovery after 3s
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU125D81" OID="3a65fedf-fe71-4032-9872-ae8df675ce53">
                                    <SHORT-NAME>DTCU125D81</SHORT-NAME>
                                    <TROUBLE-CODE>13786497</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U125D81</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_298810827">BMS_Control_Message communication verification failure</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_1500449526">1. Check CAN bus wiring to confirm it reliable
2. Check the equivalent impedence between CANH and CANL
3. Check the checksum algorithm and rolling counter mechanism
4. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_93020266">1. The 12V battery voltage above 9V and below 18V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_287143222">Rolling counter error,checksum error.
1. Checksum contimuous verification error N1 times;
OR 2. Maximum difference value of counter&gt;=A, N2 times continously;
OR 3. Number of times of continuous repetition of the counter value N3 times;
OR 4. During normal communicaiton, counter=0x0F repeats N4 times continuously;
( N1=1; A=1; N2=1; N3=1; N4=1)</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1399434376">1. Checksum is correct;
AND 2. Counter maximum difference&lt;A;
AND 3. The counter value is not repeated;
AND 4. During normal communication, the counter=0x0F does not appear;

( A=1)</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_599339611">1. CAN bus wiring abnormal
2. The equivalent impedence between CANH and CANL abnormal
3. Interference on CAN bus
4. CAN bus circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_689841219">1. Disable output, and try to recovery after 3s
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU125E87" OID="10d53249-1064-4325-967a-533f27d44f72">
                                    <SHORT-NAME>DTCU125E87</SHORT-NAME>
                                    <TROUBLE-CODE>13786759</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U125E87</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1120272327">Lost communication with BMS</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_973092910">1. Check CAN bus wiring to confirm it reliable
2. Check the equivalent impedence between CANH and CANL
3. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1803576134">1. The 12V battery voltage above 9V and below 18V
AND 2. Received charging request from BMS
AND 3. No busoff or after recovery from busoff for 1s</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_862411963">Time out for all messages from BMS.
If the message period &lt; 500ms, the timeout time =10*period, otherwise the timeout time =5000ms</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1170672359">1.When one or more messages are received again
OR 2. Auto-cleared after DC-DC converter enters standby mode</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_599339611">1. CAN bus wiring abnormal
2. The equivalent impedence between CANH and CANL abnormal
3. Interference on CAN bus
4. CAN bus circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_689841219">1. Disable output, and try to recovery after 3s
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCU126188" OID="5ce2cc3b-7fcf-4a0d-8ef1-4ce1f630d886">
                                    <SHORT-NAME>DTCU126188</SHORT-NAME>
                                    <TROUBLE-CODE>13787528</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>U126188</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_414035050">CAN BusOff</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_973092910">1. Check CAN bus wiring to confirm it reliable
2. Check the equivalent impedence between CANH and CANL
3. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_93020266">1. The 12V battery voltage above 9V and below 18V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1744897798">tx error counter exceeds 255 for N times
(N=3)</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_544856957">CAN send message successfully again</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_599339611">1. CAN bus wiring abnormal
2. The equivalent impedence between CANH and CANL abnormal
3. Interference on CAN bus
4. CAN bus circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_689841219">1. Disable output, and try to recovery after 3s
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                            </DTCS>
                        </DTC-DOP>
                    </DTC-DOPS>
