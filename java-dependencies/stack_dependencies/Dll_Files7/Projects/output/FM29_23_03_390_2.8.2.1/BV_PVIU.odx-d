                                <DTC ID="DTCP12BE44" OID="76fdb6a4-6a07-47c0-af8a-db7f2045893e">
                                    <SHORT-NAME>DTCP12BE44</SHORT-NAME>
                                    <TROUBLE-CODE>1228356</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>P12BE44</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1906550224">DC-DC Converter internal error</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1689274323">Check next halt</SD>
                                            <SD SI="Repair_Action" TI="TI_1487296486">1. Restart, if the DTC still exist, then replace the DC-DC</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_93020266">1. The 12V battery voltage above 9V and below 18V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_419377187">5ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_98739982">1. MCU selftest failure;
OR 2. Internal power supply error;
OR 3. Internal temperature higher than 110 ℃
OR 4. Internal voltage exceed its normal range
OR 5. Internal current exceed its normal rang</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1023121736">1. MCU selftest successful
AND 2.Internal power supply normal;
AND 3. Internal temperature is lower than or equal to 110℃;
AND 4. Internal voltage normal;
AND 5. Internal current normal</SD>
                                            <SD SI="Limp_home_Action" TI="TI_427537655">Disable PV charging</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_202559080">1. MCU abnormal
2. Internal circuit abnormal</SD>
                                            <SD SI="Possible_Impact" TI="TI_87524332">1. Disable output, and try to recovery
2. Report the fault status and fault code 
3. Record the DTC</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
