                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1826033865">YES</SD>
                                            <SD SI="Repair_Action" TI="TI_1230479426">1. Check whether the electronic lock is normal.</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_662639286">DC charging or AC charging/V2L/V2V</SD>
                                            <SD SI="Monitor_Type" TI="TI_1660869490">Continuous</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1451217794">10ms</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_439110349">During AC charging , received unlock command from VCU but charge enable is still active;
'During EU/US/TW/SA/KR DC charging , received unlock command from VCU but DC relay close command still active;</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1906046049">5s (after charging session interrupted and unlock successful).</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1126449708">Record DTC</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_186490916">40</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_740783465">Unexpected VCU command during charging.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1167863891">record DTC and report lock status=uolock firstly,then OBC stops charge/discharge and unlock the E-lock;
during DC charge,record DTC and report lock status=uolock firstly,then wait for VCU open DC relay command and unlock.</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
