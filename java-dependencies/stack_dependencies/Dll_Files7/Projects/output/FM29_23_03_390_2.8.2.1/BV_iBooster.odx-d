                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_139793511">The motor test is activated at start up and cyclically to control the motor open loop by minimum one electrical rotation. During this movement the current vector length, the angle between current and voltage vector, the angle between rotor and current vector, the vector length and angle of the complex motor impedance are monitored against  max and min thresholds.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1188882763">Electrical failure in B6 bridge, phase current sensing, rotor position sensing, motor or mechanical failure (locking or high friction).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC238EAF" OID="46726061-6174-43dc-911c-7d1d72e32e2d">
                                    <SHORT-NAME>DTCC238EAF</SHORT-NAME>
