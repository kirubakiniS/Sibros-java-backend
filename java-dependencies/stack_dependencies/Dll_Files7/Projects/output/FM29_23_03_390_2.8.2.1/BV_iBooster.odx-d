                                <DTC ID="DTCC239BA2" OID="0bb0c950-11dd-4ee8-b09d-8081d713b730">
                                    <SHORT-NAME>DTCC239BA2</SHORT-NAME>
                                    <TROUBLE-CODE>6527906</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C239BA2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1971471853">The ASIC provides an internal current reference that is used for monitorings/internal checks. An continous internal ASIC check will write out of range bits if the current reference is unreliable/unstable. If current reference is out of range a reset should be issued for the ASIC on which the out of range bits were detected.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1715879182">Problem of ASIC reset logic.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC239BA3" OID="87e6adfb-9d87-4333-9bce-16c92cd812b6">
