                                <DTC ID="DTCC2396A0" OID="53a0181b-d12b-4625-9195-f26d50b02fec">
                                    <SHORT-NAME>DTCC2396A0</SHORT-NAME>
                                    <TROUBLE-CODE>6526624</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2396A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_294048392">Control Module Processor</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1089258085">Logic Build-In Self-Test (LBIST) and Memory Build-In Self-Test (MBIST) are performed during microcontroller start up by HW and the corresponding test results are evaluated by SW.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1143876895">Failure detected in non-redundant safety measures (e.g. compare units) by LBIST or memory failure detected in Global RAM, Local RAM or Peripheral RAMs by MBIST (uncorrectable ECC fault or limit of ECC correctable bit faults exceeded).</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC239AA0" OID="ddc15b15-f60f-4ff7-99ca-52cb4ee22c48">
                                    <SHORT-NAME>DTCC239AA0</SHORT-NAME>
                                    <TROUBLE-CODE>6527648</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C239AA0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_933356176">Internal Control Module Random Access Memory (RAM) Error</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1933703433">RAM is protected by Error Correction Code (ECC). In addition there are three different tests running:1. Pattern Test: Differentiation between correctable and uncorrectable faults2. Data-Path Test: Detection of coupling faults between neighboring RAM cells3. Address-Path Test: Detection of addressing faults</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_2057828884">1. Uncorrectable RAM ECC fault2. Limit of RAM ECC correctable bit faults exceeded3. Coupling between neighbouring RAM cells4. RAM addressing faults</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
