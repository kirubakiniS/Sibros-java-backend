                                    <TROUBLE-CODE>6524586</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C238EAA</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_681885927">The UBB voltage is in undervoltage level1 failure range. System shall be in 'ReducedPerformance' state.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1177293837">This failure is logged when the supply voltage is below the level1 undervoltage threshold. The failure is recovered when the voltage rises above the threshold. A voltage hysteresis is considered to avoid toggling.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1094792391">The supply voltage is below the level1 undervoltage threshold.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC238EAB" OID="537ce134-4730-4f95-8909-a9cc406bcafb">
                                    <SHORT-NAME>DTCC238EAB</SHORT-NAME>
                                    <TROUBLE-CODE>6524587</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C238EAB</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1096191623">The UBB voltage is in overvoltage level1 failure range. System shall be in 'ReducedPerformance' state.</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_655634383">This failure is logged when the supply voltage is above the level1 overvoltage threshold. The failure is recovered when the voltage falls below the threshold. A voltage hysteresis is considered to avoid toggling.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1853800423">The supply voltage is above the level1 overvoltage threshold.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
