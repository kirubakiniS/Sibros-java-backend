                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2395A0" OID="0b20933c-22f3-46a5-a40a-3526345424bc">
                                    <SHORT-NAME>DTCC2395A0</SHORT-NAME>
                                    <TROUBLE-CODE>6526368</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2395A0</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1327292723">The failsafe logic test tests whether the clockin monitor of the system IC detects a too high, a too low or a correct clockin frequency. This failure is logged if the feedback to the uC does not show the expected clockin failure state.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_204140394">Erroneous safety logic (The clockin monitor of the system IC reports wrong clockin failure status to the uC)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2395A1" OID="6cfbabe9-3fd6-4dcc-8ce1-51a022901145">
                                    <SHORT-NAME>DTCC2395A1</SHORT-NAME>
                                    <TROUBLE-CODE>6526369</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2395A1</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_317203969">The failsafe logic test tests whether the BIST state machine does detect and suppress a wrong BIST command value. This failure is logged if the watchdog of the system chip is triggered by the wrong BIST command value.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_191965652">Erroneous safety logic (the BIST state machine of the system chip could be activated by a wrong BIST command value)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2395A2" OID="dc0f932d-1f2d-4cdd-80ab-052c5e6cbcc0">
                                    <SHORT-NAME>DTCC2395A2</SHORT-NAME>
                                    <TROUBLE-CODE>6526370</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2395A2</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_910471159">The failsafe logic test tests whether the watchdog of the system chip can be started with the first watchdog trigger signal from the BIST state machine. Additionally it is tested that the watchdog switches off hydraulically respective electrically if the BIST state machine is not triggered during the corresponding timeout times.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_346956636">Erroneous safety logic (e.g. BIST of system IC either does not detect a correct BIST command or missing BIST commands)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2395A3" OID="1c1ebbe6-740e-439c-9c9b-c8d7bd0076a3">
                                    <SHORT-NAME>DTCC2395A3</SHORT-NAME>
                                    <TROUBLE-CODE>6526371</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2395A3</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1783254493">The failsafe logic test tests that after 3 wrong BIST commands the BIST failure counter counted up to its max. value and that the BIST state machine switches off electrically consequently.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_805132573">Erroneous safety logic (BIST of system IC does not switch off electrically after too much received wrong BIST commands)</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
                                <DTC ID="DTCC2395A4" OID="0ddb600c-3c32-4393-8f2e-2eca0f540e4c">
                                    <SHORT-NAME>DTCC2395A4</SHORT-NAME>
                                    <TROUBLE-CODE>6526372</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C2395A4</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_1570709159">Control Module Performance</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1427398978">The failsafe logic test pulls the error pin to test the error pin event counter within the system chip.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
