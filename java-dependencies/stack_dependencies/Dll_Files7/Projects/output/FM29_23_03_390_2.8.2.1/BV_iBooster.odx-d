                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_758833323">The test checks for two things: Switchability of MOSFET and Conductivity of MOSFET. The switchability of MOSFET can be checked by switching ON and OFF each MOSFET individually. The conductivity of MOSFET is checked by taking the ratio of input and output voltages.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1528168434">Defect in Bridge Driver Supply Switch MOSFET. Defect can either be MOSFET Open or MOSFET Shorted to HIGH or MOSFET Shorted to LOW.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
