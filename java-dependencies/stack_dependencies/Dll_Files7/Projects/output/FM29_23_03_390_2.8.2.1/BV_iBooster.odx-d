                                <DTC ID="DTCC239BA6" OID="36a0ff45-076b-4dc1-9957-711c399a7f6f">
                                    <SHORT-NAME>DTCC239BA6</SHORT-NAME>
                                    <TROUBLE-CODE>6527910</TROUBLE-CODE>
                                    <DISPLAY-TROUBLE-CODE>C239BA6</DISPLAY-TROUBLE-CODE>
                                    <TEXT TI="TI_364451974">Sensor Power Supply "A" Circuit/Open</TEXT>
                                    <SDGS>
                                        <SDG SI="EXTRAINFO">
                                            <SD SI="Service_Relevant" TI="TI_1248298869">NA</SD>
                                            <SD SI="Repair_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Enable_Conditions" TI="TI_1486845611">-</SD>
                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_1921283899">Monitor checks UEXS (external 5V sensor supply) over-temperature bit and switches off UEXS to avoid a toggling system in case of an error. After a cool-down phase UEXS is switched on again to re-check if the failure is still present - if it is not the failure will be healed. Once the switch on limit is reached it's not possible re-check in the current power cycle.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_1221005433">High load at UEXS e.g. due to external short-circuit.</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
                                        </SDG>
                                    </SDGS>
                                </DTC>
