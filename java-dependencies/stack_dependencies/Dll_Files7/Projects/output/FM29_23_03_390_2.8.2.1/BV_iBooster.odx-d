                                            <SD SI="Monitor_Type" TI="TI_1248298869">NA</SD>
                                            <SD SI="Monitor_Rate" TI="TI_1248298869">NA</SD>
                                            <SD SI="Failure_Criteria_Test_Result_NOK" TI="TI_868502259">Based on the differential motor model equations the expected voltage vector is calculated from measured motor phase currents and motor speed. This is compared to the output of the field-oriented current controller. In case of large deviations the failure entry is triggered.</SD>
                                            <SD SI="Pass_Criteria_Test_Result_OK" TI="TI_1248298869">NA</SD>
                                            <SD SI="Limp_home_Action" TI="TI_1248298869">NA</SD>
                                            <SD SI="DTC_Aged_Crieria" TI="TI_1248298869">NA</SD>
                                            <SD SI="Cause_of_Failure" TI="TI_35365701">B6 bridge, phase current sensing, rotor position sensing or motor broken</SD>
                                            <SD SI="Possible_Impact" TI="TI_1248298869">NA</SD>
