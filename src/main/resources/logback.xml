<?xml version = "1.0" encoding = "UTF-8"?>
<configuration>

    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} [%highlight(%-5level)] %magenta(%logger{36}) - %msg%n%rEx"/>
    <property name="LOG_ROOT" value="/srv/BlueBinaries/Diagnostics/Java_Microservices_Logs/VehicleStackCommunication"/>
    <property name="LOG_FILE_NAME" value="vehicleStackCommunication"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_PATTERN}</pattern>
            <outputPatternAsHeader>true</outputPatternAsHeader>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_ROOT}/${LOG_FILE_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_ROOT}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>
            <!-- Maximum size of each log file -->
            <maxFileSize>5MB</maxFileSize>
            <!-- Keep only the latest 7 day of log files -->
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>
    <logger name="com.dtd.vehiclestackcommunication" level="DEBUG">
        <appender-ref ref="FILE"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>